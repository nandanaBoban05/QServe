@model List<QServe.Models.MenuCategory>
@{
    ViewData["Title"] = "Menu";
    int tableId = ViewBag.TableId;
    string token = Context.Session.GetString($"token:table:{tableId}") ?? "";
    var popularItemIds = (HashSet<int>)ViewBag.PopularItemIds;
    int cartCount = ViewBag.CartCount ?? 0;
    int priorOrderCount = ViewBag.PriorOrderCount ?? 0;
}

<div class="ticket-shell" style="padding-bottom:80px;">
    <div class="ticket-brand">
        <img src="~/images/logo.png" alt="QServe" width="20" height="20" class="brand-logo brand-logo--plain" />
        <span>QServe</span>
    </div>

    <div class="ticket-topline">
        <span class="table-stamp">TABLE @ViewBag.TableNumber</span>
        <a class="cart-tab" href="@Url.Action("Cart", new { tableId })">Cart &middot; @cartCount</a>
    </div>

    @if (priorOrderCount > 0)
    {
        <a href="@Url.Action("TableOrders", new { tableId })" class="ticket-card" style="display:flex; justify-content:space-between; align-items:center; text-decoration:none; color:inherit; background:var(--turmeric-tint); border-color:var(--turmeric-deep); margin-bottom:14px;">
            <span style="font-size:13.5px;">
                <strong>@priorOrderCount</strong> active order@(priorOrderCount == 1 ? "" : "s") placed at this table
            </span>
            <span class="mono" style="font-size:12px; color:var(--turmeric-deep); font-weight:700;">View &rarr;</span>
        </a>
    }

    <!-- Category Jump Pills Navigation -->
    @if (Model.Count > 1)
    {
        <div style="display:flex; gap:6px; overflow-x:auto; padding:6px 0 14px; -webkit-overflow-scrolling:touch; scrollbar-width:none;">
            @foreach (var cat in Model)
            {
                <a href="#cat-@cat.CategoryID" class="btn btn-outline btn-sm" style="white-space:nowrap; padding:4px 12px; font-size:12px; border-radius:16px;">
                    @cat.Name
                </a>
            }
        </div>
    }

    @foreach (var category in Model)
    {
        <div id="cat-@category.CategoryID" style="scroll-margin-top:20px;">
            <h2 class="course-heading" style="margin-top:16px; margin-bottom:10px;">@category.Name</h2>

            @if (!category.Items.Any())
            {
                <p class="text-muted" style="font-size:13px; margin-bottom:16px;">No items currently available in this section.</p>
            }

            @foreach (var item in category.Items)
            {
                <div class="ticket-card @(!item.IsAvailable ? "item-unavailable" : "")" style="@(!item.IsAvailable ? "opacity:0.65; background:var(--surface-sunken);" : "")">
                    <div class="ticket-card__row" style="align-items:flex-start;">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" class="ticket-card__thumb" onerror="this.remove()" />
                        }
                        <div style="flex:1;">
                            <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                                <span class="ticket-card__name">@item.Name</span>
                                @if (popularItemIds.Contains(item.ItemID))
                                {
                                    <span class="stamp stamp-turmeric" style="font-size:10px; padding:1px 6px;">Popular</span>
                                }
                            </div>
                            <div class="ticket-card__meta" style="margin-top:2px;">
                                @{
                                    string typeBadge = item.ItemType switch {
                                        "Cooked" => "badge-tamarind",
                                        "Dessert" => "badge-turmeric",
                                        "Beverage" => "badge-steel",
                                        _ => "badge-curry"
                                    };
                                }
                                <span class="badge @typeBadge" style="font-size:10px; padding:2px 6px;">@item.ItemType</span>
                                <span class="text-muted mono" style="font-size:11px;">&middot; ~@item.PrepTimeMinutes mins</span>
                            </div>
                        </div>
                        <div class="ticket-card__price">₹@item.Price.ToString("0.00")</div>
                    </div>

                    @if (item.IsAvailable)
                    {
                        <form asp-action="AddToCart" asp-route-tableId="@tableId" method="post" class="add-row" style="margin-top:10px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.ItemID" />
                            <input type="number" name="quantity" value="1" min="1" max="50" class="qty-input"
                                   aria-label="Quantity for @item.Name" />
                            <input type="text" name="customization" placeholder="Notes (e.g. less spicy, no nuts)" class="custom-input"
                                   aria-label="Customization notes for @item.Name" />
                            <button type="submit" class="btn btn-primary btn-sm" aria-label="Add @item.Name to Cart">+ Add</button>
                        </form>
                    }
                    else
                    {
                        <div style="margin-top:8px; font-size:12px; color:var(--tamarind); font-weight:600;">
                            Currently Sold Out
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Sticky Floating Mobile Cart Bar -->
    @if (cartCount > 0)
    {
        <div style="position:fixed; bottom:16px; left:0; right:0; max-width:480px; margin:0 auto; padding:0 16px; z-index:100;">
            <a href="@Url.Action("Cart", new { tableId })" class="btn btn-primary btn-block" style="display:flex; justify-content:space-between; align-items:center; box-shadow:0 4px 14px rgba(0,0,0,0.18); padding:14px 20px; font-size:15px;">
                <span>View Cart &middot; <strong>@cartCount</strong> item@(cartCount == 1 ? "" : "s")</span>
                <span>Proceed &rarr;</span>
            </a>
        </div>
    }
</div>
