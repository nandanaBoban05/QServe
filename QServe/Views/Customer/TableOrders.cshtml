@model List<QServe.Models.Order>
@{
    ViewData["Title"] = "Your Orders";
    int tableId = ViewBag.TableId;
}

<div class="ticket-shell">
    <div class="ticket-brand">
        <img src="~/images/logo.png" alt="" width="18" height="18" class="brand-logo brand-logo--plain" />
        <span>QServe</span>
    </div>
    <div class="ticket-topline">
        <span class="table-stamp">TABLE @ViewBag.TableNumber</span>
        <a class="cart-tab" href="@Url.Action("Menu", new { tableId })">+ Add More</a>
    </div>

    <h1 style="font-size:22px; margin-bottom:4px;">Your Orders</h1>
    <p class="text-muted" style="font-size:13px; margin-top:0;">Everything placed at this table today. Each round is tracked separately.</p>

    @if (!Model.Any())
    {
        <div class="ticket-card">
            <p class="text-muted" style="margin:0;">No orders placed yet.</p>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <a href="@Url.Action("Status", new { orderId = order.OrderID })" style="text-decoration:none; color:inherit;">
                <div class="ticket-card">
                    <div class="ticket-card__row">
                        <div>
                            <div class="ticket-card__name mono">Order #@order.OrderID.ToString("D6")</div>
                            <div class="ticket-card__meta">
                                <span class="badge @(order.OrderStatus is "Served" ? "badge-curry" : order.OrderStatus is "Cancelled" ? "badge-tamarind" : "badge-turmeric")">
                                    @order.OrderStatus
                                </span>
                                <span class="text-muted mono" style="font-size:11px;">@order.CreatedAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                        <div class="ticket-card__price">₹@order.TotalAmount.ToString("0.00")</div>
                    </div>
                </div>
            </a>
        }
    }

    <a href="@Url.Action("Menu", new { tableId })" class="btn btn-primary btn-block mt-lg" style="padding:14px;">
        + Add More Items
    </a>
</div>
