@model List<QServe.Models.Order>
@{
    ViewData["Title"] = "Your Table Orders";
    int tableId = ViewBag.TableId;
}

<div class="ticket-shell">
    <div class="ticket-brand">
        <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "120" }, { "LogoHeight", "60" }, { "LogoClass", "brand-logo brand-logo--plain" } }' />
    </div>
    <div class="ticket-topline">
        <span class="table-stamp">TABLE @ViewBag.TableNumber</span>
        <a class="btn btn-ghost btn-sm" href="@Url.Action("Menu", new { tableId })">+ Add More</a>
    </div>

    <h1 class="headline-lg" style="margin-bottom:6px;">Your Orders</h1>
    <p class="text-muted" style="font-size:13.5px; margin-top:0; margin-bottom:20px;">
        Everything placed at this table today. Each round is tracked individually.
    </p>

    @if (!Model.Any())
    {
        <div class="card" style="text-align:center; padding:36px 20px;">
            <p class="text-muted" style="margin:0;">No orders placed yet.</p>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <a href="@Url.Action("Status", new { orderId = order.OrderID })" style="text-decoration:none; color:inherit; display:block;">
                <div class="ticket-card">
                    <div class="ticket-card__row">
                        <div>
                            <div class="ticket-card__name mono" style="font-size:16px;">Order #@order.OrderID.ToString("D5")</div>
                            <div class="ticket-card__meta" style="margin-top:6px;">
                                @{
                                    string badgeClass = order.OrderStatus switch {
                                        "Approved" => "badge-approved",
                                        "Preparing" => "badge-preparing",
                                        "Ready" => "badge-ready",
                                        "Served" => "badge-served",
                                        "Cancelled" => "badge-cancelled",
                                        "PendingPayment" => "badge-pending",
                                        "AwaitingVerification" => "badge-awaiting",
                                        _ => "badge-neutral"
                                    };
                                }
                                <span class="badge @badgeClass">@order.OrderStatus</span>
                                <span class="text-muted mono" style="font-size:12px;">&middot; @order.CreatedAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                        <div class="ticket-card__price" style="font-size:16px; color:var(--primary);">
                            ₹@order.TotalAmount.ToString("0.00")
                        </div>
                    </div>
                </div>
            </a>
        }
    }

    <a href="@Url.Action("Menu", new { tableId })" class="btn btn-primary btn-block mt-lg" style="padding:15px; border-radius:var(--radius-pill);">
        + Order More Items
    </a>
</div>
