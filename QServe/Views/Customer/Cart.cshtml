@model List<QServe.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    int tableId = ViewBag.TableId;
    var total = Model.Sum(c => c.LineTotal);
    int totalItems = Model.Sum(c => c.Quantity);
}

<div class="ticket-shell">
    <div class="ticket-brand">
        <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "200" }, { "LogoHeight", "100" }, { "LogoClass", "brand-logo brand-logo--plain" } }' />
    </div>
    <div class="ticket-topline">
        <span class="table-stamp">TABLE @ViewBag.TableNumber</span>
        <a class="btn btn-ghost btn-sm" href="@Url.Action("Menu", new { tableId, token = Context.Session.GetString($"token:table:{tableId}") })">
            &larr; Back to Menu
        </a>
    </div>

    <h1 class="headline-lg" style="margin-bottom:16px;">Review Your Order</h1>

    @if (TempData["CartError"] is string cartError)
    {
        <div class="validation-summary-errors" style="margin-bottom:16px;">
            <p>@cartError</p>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card" style="text-align:center; padding:48px 20px;">
            <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <p class="empty-state-text" style="font-size:16px; margin:12px 0 16px;">Your cart is empty</p>
            <a href="@Url.Action("Menu", new { tableId })" class="btn btn-primary btn-sm" style="padding:10px 20px; border-radius:var(--radius-pill);">Browse Menu &rarr;</a>
        </div>
    }
    else
    {
        <div class="card" style="padding:16px 20px;">
            @for (int i = 0; i < Model.Count; i++)
            {
                var line = Model[i];
                <div class="receipt-line" style="display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid var(--surface-container-high);">
                    <div style="flex:1; padding-right:12px;">
                        <div class="ticket-card__name" style="font-size:15px; font-weight:700;">@line.Name</div>
                        @if (!string.IsNullOrWhiteSpace(line.Customization))
                        {
                            <div class="text-muted" style="font-size:12px; margin-top:2px; font-style:italic;">
                                Note: @line.Customization
                            </div>
                        }
                        <div class="mono text-muted" style="font-size:12.5px; margin-top:3px;">
                            ₹@line.UnitPrice.ToString("0.00") each
                        </div>
                    </div>

                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px;">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <!-- Quantity Stepper -->
                            <form asp-action="UpdateCart" asp-route-tableId="@tableId" method="post" style="display:inline-flex; align-items:center; border:1px solid var(--outline-variant); border-radius:var(--radius-md); overflow:hidden; background:var(--surface-container-low);">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="itemId" value="@line.ItemID" />
                                <input type="hidden" name="customization" value="@line.Customization" />
                                
                                <button type="submit" name="quantity" value="@(line.Quantity - 1)" class="btn btn-ghost btn-sm" aria-label="Decrease quantity" style="padding:4px 8px; font-size:14px; font-weight:700; border-radius:0; height:28px; line-height:1;">
                                    &minus;
                                </button>
                                <span class="mono" style="min-width:26px; text-align:center; font-weight:700; font-size:13px; color:var(--on-surface);">
                                    @line.Quantity
                                </span>
                                <button type="submit" name="quantity" value="@(line.Quantity + 1)" class="btn btn-ghost btn-sm" aria-label="Increase quantity" style="padding:4px 8px; font-size:14px; font-weight:700; color:var(--primary); border-radius:0; height:28px; line-height:1;">
                                    +
                                </button>
                            </form>

                            <!-- Explicit Remove Button -->
                            <form asp-action="RemoveFromCart" asp-route-tableId="@tableId" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="itemId" value="@line.ItemID" />
                                <input type="hidden" name="customization" value="@line.Customization" />
                                <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--error); padding:4px 8px; font-size:12px; font-weight:600;" title="Remove item">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:text-bottom;">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                    Remove
                                </button>
                            </form>
                        </div>

                        <div class="mono" style="font-weight:700; font-size:14.5px; color:var(--on-surface);">
                            ₹@line.LineTotal.ToString("0.00")
                        </div>
                    </div>
                </div>
            }

            <div class="receipt-total" style="padding-top:14px;">
                <span>Total (<span id="cart-item-count">@totalItems</span> items)</span>
                <span id="cart-grand-total" class="mono" style="color:var(--primary); font-size:20px;">₹@total.ToString("0.00")</span>
            </div>
        </div>

        <form id="checkout-form" asp-action="Checkout" asp-route-tableId="@tableId" method="post" class="mt-lg">
            @Html.AntiForgeryToken()
            <h3 style="margin-bottom:14px; font-size:16px;">Choose Payment Method</h3>

            <div style="display:flex; flex-direction:column; gap:10px;">
                <label class="payment-choice">
                    <input type="radio" name="paymentMode" value="Online" checked />
                    <div>
                        <strong style="display:block; font-size:14.5px; color:var(--on-surface);">Online Payment (UPI, Cards, NetBanking)</strong>
                        <span class="text-muted" style="font-size:12.5px;">Instant seamless checkout via Razorpay</span>
                    </div>
                </label>

                <label class="payment-choice">
                    <input type="radio" name="paymentMode" value="Cash" />
                    <div>
                        <strong style="display:block; font-size:14.5px; color:var(--on-surface);">Cash Payment at Front Desk</strong>
                        <span class="text-muted" style="font-size:12.5px;">Complete cash payment at the Cash Manager / Front Desk</span>
                    </div>
                </label>

                <label class="payment-choice">
                    <input type="radio" name="paymentMode" value="Card" />
                    <div>
                        <strong style="display:block; font-size:14.5px; color:var(--on-surface);">POS Card Payment at Front Desk</strong>
                        <span class="text-muted" style="font-size:12.5px;">Complete card swipe/tap payment at the Cash Manager / Front Desk</span>
                    </div>
                </label>
            </div>

            <button type="submit" id="place-order-btn" class="btn btn-primary btn-block mt-lg" style="padding:16px; font-size:16px; font-weight:700; border-radius:var(--radius-pill); box-shadow:0 6px 20px rgba(245, 158, 11, 0.3);">
                Place Order &middot; ₹@total.ToString("0.00")
            </button>
        </form>
    }
</div>

<script>
    // Real-time calculation on typing quantity
    document.querySelectorAll(".cart-qty").forEach(input => {
        input.addEventListener("input", () => {
            const price = parseFloat(input.dataset.price);
            const qty = Math.max(0, parseInt(input.value, 10) || 0);
            const lineTotalEl = document.getElementById(`line-total-${input.dataset.lineIndex}`);
            if (lineTotalEl) lineTotalEl.textContent = `₹${(price * qty).toFixed(2)}`;

            let grandTotal = 0;
            let totalCount = 0;
            document.querySelectorAll(".cart-qty").forEach(el => {
                const p = parseFloat(el.dataset.price);
                const q = Math.max(0, parseInt(el.value, 10) || 0);
                grandTotal += p * q;
                totalCount += q;
            });
            const grandTotalEl = document.getElementById("cart-grand-total");
            if (grandTotalEl) grandTotalEl.textContent = `₹${grandTotal.toFixed(2)}`;
            const itemCountEl = document.getElementById("cart-item-count");
            if (itemCountEl) itemCountEl.textContent = totalCount;
            const btn = document.getElementById("place-order-btn");
            if (btn) btn.textContent = `Place Order · ₹${grandTotal.toFixed(2)}`;
        });
    });

    // Double-submit prevention
    const checkoutForm = document.getElementById("checkout-form");
    if (checkoutForm) {
        checkoutForm.addEventListener("submit", function () {
            const submitBtn = document.getElementById("place-order-btn");
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "Placing order...";
            }
        });
    }
</script>
