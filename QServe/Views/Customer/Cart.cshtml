@model List<QServe.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    int tableId = ViewBag.TableId;
    var total = Model.Sum(c => c.LineTotal);
}

<div class="ticket-shell">
    <div class="ticket-brand">
        <img src="~/images/logo.png" alt="" width="18" height="18" class="brand-logo brand-logo--plain" />
        <span>QServe</span>
    </div>
    <div class="ticket-topline">
        <span class="table-stamp">TABLE @ViewBag.TableNumber</span>
        <a class="cart-tab" href="@Url.Action("Menu", new { tableId, token = Context.Session.GetString($"token:table:{tableId}") })">Back to Menu</a>
    </div>

    <h1 style="font-size:22px; margin-bottom:16px;">Your Order</h1>

    @if (!Model.Any())
    {
        <div class="ticket-card">
            <p class="text-muted" style="margin:0;">Your cart is empty.</p>
        </div>
    }
    else
    {
        <div class="card" style="padding:16px 18px;">
            @for (int i = 0; i < Model.Count; i++)
            {
                var line = Model[i];
                <div class="receipt-line">
                    <div>
                        <div class="ticket-card__name">@line.Name</div>
                        @if (!string.IsNullOrWhiteSpace(line.Customization))
                        {
                            <div class="text-muted" style="font-size:12px;">@line.Customization</div>
                        }
                        <div class="mono text-muted" style="font-size:12px;">₹@line.UnitPrice.ToString("0.00") each</div>
                    </div>
                    <form asp-action="UpdateCart" asp-route-tableId="@tableId" method="post" style="display:flex; gap:4px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemId" value="@line.ItemID" />
                        <input type="hidden" name="customization" value="@line.Customization" />
                        <input type="number" name="quantity" value="@line.Quantity" min="0" max="50"
                               class="qty-input cart-qty" data-price="@line.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               data-line-index="@i" />
                        <button type="submit" class="btn btn-outline btn-sm">Update</button>
                    </form>
                    <div class="mono line-total" id="line-total-@i" style="font-weight:600;">₹@line.LineTotal.ToString("0.00")</div>
                </div>
            }

            <div class="receipt-total">
                <span>Total</span>
                <span id="cart-grand-total">₹@total.ToString("0.00")</span>
            </div>
        </div>

        <form asp-action="Checkout" asp-route-tableId="@tableId" method="post" class="mt-lg">
            @Html.AntiForgeryToken()
            <h3 style="margin-bottom:10px;">Select payment method</h3>

            <label class="payment-choice">
                <input type="radio" name="paymentMode" value="Online" checked /> Online (UPI / Card)
            </label>
            <label class="payment-choice">
                <input type="radio" name="paymentMode" value="Cash" /> Cash
            </label>
            <label class="payment-choice">
                <input type="radio" name="paymentMode" value="Card" /> Physical POS Card
            </label>

            <button type="submit" class="btn btn-primary btn-block mt-lg" style="padding:14px;">Place Order</button>
        </form>
    }
</div>

<script>
    // Gap fix (CUST-5): the total previously only updated after a full server round-trip via
    // the "Update" button. This recalculates instantly as the customer types a new quantity —
    // purely a display refresh; the actual persisted change still happens on "Update" submit,
    // this just removes the lag between typing and seeing the new total.
    document.querySelectorAll(".cart-qty").forEach(input => {
        input.addEventListener("input", () => {
            const price = parseFloat(input.dataset.price);
            const qty = Math.max(0, parseInt(input.value, 10) || 0);
            const lineTotalEl = document.getElementById(`line-total-${input.dataset.lineIndex}`);
            if (lineTotalEl) lineTotalEl.textContent = `₹${(price * qty).toFixed(2)}`;

            let grandTotal = 0;
            document.querySelectorAll(".cart-qty").forEach(el => {
                const p = parseFloat(el.dataset.price);
                const q = Math.max(0, parseInt(el.value, 10) || 0);
                grandTotal += p * q;
            });
            const grandTotalEl = document.getElementById("cart-grand-total");
            if (grandTotalEl) grandTotalEl.textContent = `₹${grandTotal.toFixed(2)}`;
        });
    });
</script>
