@model QServe.Models.Order
@{
    ViewData["Title"] = "Order #" + Model.OrderID.ToString("D5");
}

<div class="ticket-shell" style="text-align:center;">
    <div class="ticket-brand">
        <img src="~/images/logo.png" alt="QServe" width="20" height="20" class="brand-logo brand-logo--plain" />
        <span>QServe</span>
    </div>
    <span class="eyebrow">Order Confirmation &amp; Live Tracking</span>
    <h1 class="mono" style="font-size:26px; margin:4px 0;">#@Model.OrderID.ToString("D5")</h1>
    <p class="text-muted mono" style="font-size:13px; margin-top:-2px; margin-bottom:16px;">
        Table @(Model.Table?.TableNumber ?? Model.TableID.ToString()) &middot; @Model.CreatedAt.ToString("MMM d, HH:mm")
    </p>

    <!-- Visual Milestone Tracker -->
    <div class="punch-tracker" style="margin:20px 0;">
        @{
            var steps = new[] { "Approved", "Preparing", "Ready", "Served" };
        }
        @foreach (var step in steps)
        {
            <div class="punch-step @(IsAtOrPast(Model.OrderStatus, step) ? "done" : "")" data-step="@step">
                <div class="punch-dot"></div>
                <span class="punch-label">@step</span>
            </div>
        }
    </div>

    <!-- Live Status Banner -->
    <div class="card" style="padding:16px; margin-bottom:20px; background:var(--surface);">
        <span class="eyebrow" style="font-size:10px;">Current Status</span>
        <div style="font-size:18px; font-weight:700; margin-top:2px;" id="status-text">
            @Model.OrderStatus
        </div>

        @if (Model.OrderStatus is "PendingPayment" or "AwaitingVerification")
        {
            <p class="text-muted" style="font-size:13px; margin:8px 0 0;">
                Waiting on payment confirmation — this screen updates automatically once approved.
            </p>
        }
        else if (Model.OrderStatus == "Approved")
        {
            <p class="text-muted" style="font-size:13px; margin:8px 0 0; color:var(--curry);">
                Order approved! The kitchen has received your ticket.
            </p>
        }
        else if (Model.OrderStatus == "Preparing")
        {
            <p class="text-muted" style="font-size:13px; margin:8px 0 0; color:var(--turmeric-deep);">
                Your food is actively being prepared in the kitchen.
            </p>
        }
        else if (Model.OrderStatus == "Ready")
        {
            <p class="text-muted" style="font-size:13px; margin:8px 0 0; color:var(--curry); font-weight:600;">
                Your order is ready! A staff member is bringing it to your table.
            </p>
        }
        else if (Model.OrderStatus == "Served")
        {
            <p class="text-muted" style="font-size:13px; margin:8px 0 0; color:var(--ink-soft);">
                Enjoy your meal! Thank you for dining with QServe.
            </p>
        }
        else if (Model.OrderStatus == "Cancelled")
        {
            <p style="color:var(--tamarind); font-size:13px; margin:8px 0 0;">
                This order was cancelled. Please speak to a staff member.
            </p>
        }
    </div>

    <!-- Order Items Summary Chit -->
    @if (Model.OrderItems.Any())
    {
        <div class="card" style="text-align:left; padding:14px 16px; margin-bottom:20px;">
            <span class="eyebrow" style="font-size:10px; display:block; margin-bottom:8px;">Order Summary</span>
            <div style="display:flex; flex-direction:column; gap:6px;">
                @foreach (var item in Model.OrderItems)
                {
                    <div style="display:flex; justify-content:space-between; font-size:13px;">
                        <div>
                            <span><strong>@item.Quantity &times;</strong> @(item.Item?.Name ?? "Item #" + item.ItemID)</span>
                            @if (!string.IsNullOrWhiteSpace(item.Customization))
                            {
                                <div class="text-muted" style="font-size:11px;">@item.Customization</div>
                            }
                        </div>
                        <span class="mono">₹@((item.Quantity * item.UnitPrice).ToString("0.00"))</span>
                    </div>
                }
            </div>

            <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:8px; display:flex; justify-content:space-between; font-size:14px; font-weight:700;">
                <span>Total Paid / Payable</span>
                <span class="mono" style="color:var(--turmeric-deep);">₹@Model.TotalAmount.ToString("0.00")</span>
            </div>
        </div>
    }

    <div style="display:flex; flex-direction:column; gap:8px;">
        <a href="@Url.Action("Menu", new { tableId = Model.TableID })" class="btn btn-primary btn-block" style="padding:14px;">
            + Order More Items
        </a>
        @if ((int)(ViewBag.SessionOrderCount ?? 0) > 1)
        {
            <a href="@Url.Action("TableOrders", new { tableId = Model.TableID })" class="btn btn-outline btn-block">
                View All Table Orders
            </a>
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const currentOrderId = @Model.OrderID;
    const stepOrder = ["Approved", "Preparing", "Ready", "Served"];

    function applyStatus(newStatus) {
        if (!newStatus) return;
        const statusEl = document.getElementById("status-text");
        if (statusEl) statusEl.textContent = newStatus;

        document.querySelectorAll(".punch-step").forEach(el => {
            const idx = stepOrder.indexOf(el.dataset.step);
            const currentIdx = stepOrder.indexOf(newStatus);
            el.classList.toggle("done", currentIdx >= 0 && idx <= currentIdx);
        });
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/kitchen")
        .withAutomaticReconnect([0, 2000, 5000, 10000])
        .build();

    connection.on("OrderStatusUpdate", (data) => {
        const orderId = data.orderID || data.orderId || data.OrderID;
        const status = data.newStatus || data.NewStatus;
        if (orderId === currentOrderId) {
            applyStatus(status);
        }
    });

    connection.start().catch(err => {
        console.error("SignalR connection failed, falling back to one-time sync:", err);
        fetch(`/order/status/${currentOrderId}/json`)
            .then(res => res.ok ? res.json() : null)
            .then(data => { if (data && data.status) applyStatus(data.status); });
    });
</script>

@functions {
    bool IsAtOrPast(string current, string step)
    {
        var order = new[] { "Approved", "Preparing", "Ready", "Served" };
        var currentIdx = Array.IndexOf(order, current);
        var stepIdx = Array.IndexOf(order, step);
        return currentIdx >= 0 && stepIdx <= currentIdx;
    }
}
