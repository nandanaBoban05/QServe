@model List<QServe.ViewModels.KitchenThroughputDto>
@{
    ViewData["Title"] = "Kitchen Throughput";
    var peakHours = (List<QServe.ViewModels.PeakHourDto>)ViewBag.PeakHours;
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Kitchen Operations</span>
            <h1 class="headline-lg">KITCHEN THROUGHPUT</h1>
        </div>
    </div>

    <partial name="_ReportsNav" />
    <partial name="_DateRangeFilter" />

    <div class="card">
        <h3 style="margin-bottom:6px;">AVERAGE PREPARATION TIME BY ITEM TYPE</h3>
        <p class="text-muted" style="font-size:13px; margin-top:0; margin-bottom:16px;">
            Prep time = ServedAt &minus; ApprovedAt at order level.
        </p>

        @if (!Model.Any())
        {
            <div class="empty-state" style="padding:24px 0;">
                <p class="empty-state-text">No completed orders recorded in this date range.</p>
            </div>
        }
        else
        {
            <div class="data-table-container" style="max-width:540px;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Item Type</th>
                            <th style="text-align:right;">Avg Prep (minutes)</th>
                            <th style="text-align:right;">Completed Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td><strong style="color:var(--on-surface);">@row.ItemType</strong></td>
                            <td class="num" style="text-align:right; font-weight:700; color:var(--primary); font-size:14.5px;">@row.AvgPrepMinutes min</td>
                            <td class="num text-muted" style="text-align:right;">@row.OrdersCompleted</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card mt-lg">
        <h3 style="margin-bottom:16px;">ORDERS BY HOUR OF DAY</h3>
        @if (!peakHours.Any())
        {
            <div class="empty-state" style="padding:24px 0;">
                <p class="empty-state-text">No orders in this range.</p>
            </div>
        }
        else
        {
            <div style="display:flex; align-items:flex-end; gap:8px; height:140px; padding-top:20px; overflow-x:auto;">
                @{ var maxCount = peakHours.Max(h => h.OrderCount); }
                @foreach (var hour in peakHours)
                {
                    var heightPx = maxCount > 0 ? Math.Max(4, hour.OrderCount * 100 / maxCount) : 4;
                    <div style="display:flex; flex-direction:column; align-items:center; justify-content:flex-end; font-family:var(--font-mono); font-size:11px; color:var(--on-surface-muted); min-width:24px;">
                        <span style="font-size:10px; margin-bottom:4px; font-weight:600; color:var(--on-surface);">@hour.OrderCount</span>
                        <div style="width:16px; background:var(--primary-container); border-radius:4px 4px 0 0; height:@(heightPx)px;"></div>
                        <span style="margin-top:6px;">@hour.Hour:00</span>
                    </div>
                }
            </div>
        }
    </div>
</div>
