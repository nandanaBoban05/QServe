@model List<QServe.ViewModels.PopularItemDto>
@{
    ViewData["Title"] = "Popular Items Report";
    var byRevenue = (List<QServe.ViewModels.PopularItemDto>)ViewBag.ByRevenue;
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Item Insights</span>
            <h1 class="headline-lg">Popular Menu Items</h1>
        </div>
    </div>

    <partial name="_ReportsNav" />
    <partial name="_DateRangeFilter" />

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px;">
        <div class="card">
            <h3 style="margin-bottom:14px;">Top 10 Items by Quantity Sold</h3>
            @if (!Model.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <p class="empty-state-text">No item sales recorded in this date range.</p>
                </div>
            }
            else
            {
                <div class="data-table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                <th style="text-align:right;">Quantity Sold</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong style="color:var(--on-surface);">@item.ItemName</strong></td>
                                <td class="num" style="text-align:right; font-weight:700; font-size:15px; color:var(--primary);">
                                    @item.QuantitySold
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <h3 style="margin-bottom:14px;">Top 10 Items by Revenue</h3>
            @if (!byRevenue.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <p class="empty-state-text">No item sales recorded in this date range.</p>
                </div>
            }
            else
            {
                <div class="data-table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                <th style="text-align:right;">Total Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in byRevenue)
                        {
                            <tr>
                                <td><strong style="color:var(--on-surface);">@item.ItemName</strong></td>
                                <td class="num" style="text-align:right; font-weight:700; font-size:15px; color:var(--primary);">
                                    ₹@item.Revenue.ToString("0.00")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
