@{
    ViewData["Title"] = "Error";
}

<div class="page page--auth" style="text-align:center;">
    <div class="auth-card">
        <div style="margin:0 auto 14px; display:inline-block;">
            <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "180" }, { "LogoClass", "brand-logo brand-logo--plain" } }' />
        </div>
        <span class="badge badge-cancelled" style="font-size:12px; margin-bottom:12px;">System Notice</span>
        <h1 class="headline-md" style="margin-top:8px; margin-bottom:10px;">SOMETHING WENT WRONG</h1>
        <p class="text-muted" style="font-size:14px; line-height:1.55; margin-bottom:24px;">
            An unexpected error occurred while processing your request. Please try again or return to the main dashboard.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-block" style="padding:12px;">
            Return to Staff Login
        </a>
    </div>
</div>
