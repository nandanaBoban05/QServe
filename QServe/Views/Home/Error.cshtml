@{
    ViewData["Title"] = "Error";
}

<div class="page page--auth">
    <div class="auth-card" style="text-align:center;">
        <img src="~/images/logo.png" alt="QServe" class="brand-logo brand-logo--plain" width="48" height="48" style="margin:0 auto 12px;" />
        <h1 style="font-size:20px;">Something went wrong</h1>
        <p class="text-muted" style="font-size:13.5px; margin-top:12px;">
            An unexpected error occurred. Please try again, or contact support if the problem persists.
        </p>
        <p style="margin-top:18px;"><a asp-controller="Account" asp-action="Login">Back to login</a></p>
    </div>
</div>
