@{
    DateTime rangeStart = ViewBag.RangeStart;
    DateTime rangeEnd = ViewBag.RangeEnd;
}
<form method="get" class="field-row" style="margin-bottom:22px;">
    <div class="form-group" style="margin-bottom:0;">
        <label>From</label>
        <input type="date" name="start" value="@rangeStart.ToString("yyyy-MM-dd")" />
    </div>
    <div class="form-group" style="margin-bottom:0;">
        <label>To</label>
        <input type="date" name="end" value="@rangeEnd.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-outline btn-sm">Apply</button>
</form>
