@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
            return false;
        if (action == null)
            return true;
        return string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }
}

<!-- Mobile drawer toggle (pure CSS, no JS needed) -->
<input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" hidden>

<!-- Mobile-only top bar: hamburger + logo. Hidden on desktop. -->
<div class="mobile-topbar">
    <label for="sidebar-toggle" class="mobile-topbar__hamburger" aria-label="Open menu">
        <span class="material-symbols-outlined">menu</span>
    </label>
    <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "110" }, { "LogoClass", "mobile-topbar__logo" } }' />
</div>

<!-- Tapping the dimmed backdrop closes the drawer -->
<label for="sidebar-toggle" class="sidebar-backdrop" aria-hidden="true"></label>

<aside class="sidebar">
    <!-- Mobile-only close (X) button inside the open drawer -->
    <label for="sidebar-toggle" class="sidebar__close" aria-label="Close menu">
        <span class="material-symbols-outlined">close</span>
    </label>

    <!-- Brand Header with actual QServe Logo asset -->
    <a asp-controller="Admin" asp-action="Index" class="sidebar__brand">
        <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "170" }, { "LogoClass", "sidebar__brand-logo" } }' />
    </a>

    <!-- Admin User Badge Card -->
    <div class="sidebar__user-badge">
        <div class="sidebar__user-avatar">
            <span class="material-symbols-outlined" style="font-size: 20px;">person</span>
        </div>
        <div style="overflow: hidden;">
            <div class="sidebar__user-name" title="@(User.Identity?.Name ?? "Restaurant Admin")">
                @(User.Identity?.Name ?? "Restaurant Admin")
            </div>
            <div class="sidebar__user-role">
                @(User.IsInRole("Admin") ? "Admin • Main Branch" : "Manager • Main Branch")
            </div>
        </div>
    </div>

    <!-- Navigation Links -->
    <nav class="sidebar__links">
        <a class="sidebar__link @(IsActive("Admin", "Index") ? "active" : "")" asp-controller="Admin" asp-action="Index">
            <span class="material-symbols-outlined @(IsActive("Admin", "Index") ? "filled-icon" : "")">dashboard</span>
            <span>Dashboard</span>
        </a>

        <a class="sidebar__link @(IsActive("Admin", "Orders") || IsActive("Admin", "OrderDetails") ? "active" : "")" asp-controller="Admin" asp-action="Orders">
            <span class="material-symbols-outlined">restaurant_menu</span>
            <span>Orders</span>
        </a>

        <a class="sidebar__link @(IsActive("Admin", "PaymentQueue") ? "active" : "")" asp-controller="Admin" asp-action="PaymentQueue">
            <span class="material-symbols-outlined">pending_actions</span>
            <span>Payment Queue</span>
        </a>

        <a class="sidebar__link @(IsActive("Admin", "Payments") ? "active" : "")" asp-controller="Admin" asp-action="Payments">
            <span class="material-symbols-outlined">payments</span>
            <span>Payments</span>
        </a>

        <a class="sidebar__link @(IsActive("Admin", "Tables") ? "active" : "")" asp-controller="Admin" asp-action="Tables">
            <span class="material-symbols-outlined">table_restaurant</span>
            <span>Tables &amp; QR</span>
        </a>

        <a class="sidebar__link @(IsActive("AdminMenu", "Index") || IsActive("AdminMenu", "CreateItem") || IsActive("AdminMenu", "EditItem") ? "active" : "")" asp-controller="AdminMenu" asp-action="Index">
            <span class="material-symbols-outlined">menu_book</span>
            <span>Menu Items</span>
        </a>

        <a class="sidebar__link @(IsActive("AdminMenu", "Categories") ? "active" : "")" asp-controller="AdminMenu" asp-action="Categories">
            <span class="material-symbols-outlined">category</span>
            <span>Categories</span>
        </a>

        <a class="sidebar__link @(IsActive("AdminReports") ? "active" : "")" asp-controller="AdminReports" asp-action="Sales">
            <span class="material-symbols-outlined">analytics</span>
            <span>Analytics &amp; Reports</span>
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a class="sidebar__link @(IsActive("AdminStaff") ? "active" : "")" asp-controller="AdminStaff" asp-action="Index">
                <span class="material-symbols-outlined">badge</span>
                <span>Staff Management</span>
            </a>
        }

        <a class="sidebar__link @(IsActive("Admin", "AuditLog") ? "active" : "")" asp-controller="Admin" asp-action="AuditLog">
            <span class="material-symbols-outlined">history</span>
            <span>Audit Log</span>
        </a>
    </nav>

    <!-- Sidebar Footer / Bottom Actions -->
    <div class="sidebar__footer">
        <a asp-controller="Kitchen" asp-action="Index" target="_blank" class="btn btn-primary btn-block" style="margin-bottom: 8px; font-size: 13px; padding: 10px;">
            <span class="material-symbols-outlined" style="font-size: 18px;">tv</span>
            <span>Live Kitchen KDS</span>
        </a>

        <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar__logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar__logout">
                <span class="material-symbols-outlined" style="font-size: 16px;">logout</span>
                <span>Log out</span>
            </button>
        </form>
    </div>
</aside>