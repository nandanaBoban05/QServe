@{
    ViewData["Title"] = "Forgot Password";
    bool submitted = ViewBag.Submitted ?? false;
    string? devLink = ViewBag.DevResetLink as string;
}

<div class="page page--auth">
    <div class="auth-card" style="text-align:center;">
        <img src="~/images/logo.png" alt="QServe" class="brand-logo brand-logo--plain" width="48" height="48" style="margin:0 auto 12px;" />
        <h1 style="font-size:20px;">Forgot Password</h1>

        <div style="text-align:left; margin-top:14px;">
        @if (submitted)
        {
            <p class="text-muted" style="font-size:13.5px;">
                If that email belongs to a staff account, we've sent a link to reset the password.
                The link expires in 1 hour.
            </p>

            @if (!string.IsNullOrEmpty(devLink))
            {
                <div class="card" style="background:var(--turmeric-tint); border-color:var(--turmeric-deep); padding:12px 14px; margin-top:12px;">
                    <p style="font-size:11.5px; font-weight:600; margin:0 0 6px; text-transform:uppercase; letter-spacing:0.04em;">
                        Dev mode — no email sender configured
                    </p>
                    <p style="font-size:12px; margin:0 0 8px; color:var(--ink-soft);">
                        Since this instance has no real email sender wired up (see <code>DevEmailSender</code>),
                        here's the reset link directly, for testing:
                    </p>
                    <a href="@devLink" class="mono" style="font-size:11.5px; word-break:break-all;">@devLink</a>
                </div>
            }

            <p style="margin-top:18px; text-align:center;"><a asp-action="Login">Back to login</a></p>
        }
        else
        {
            <p class="text-muted" style="font-size:13.5px; margin-bottom:18px;">
                Enter your staff email and we'll send you a link to reset your password.
            </p>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
            </form>

            <p style="margin-top:14px; text-align:center;"><a asp-action="Login" style="font-size:13px;">Back to login</a></p>
        }
        </div>
    </div>
</div>
