@{
    ViewData["Title"] = "Forgot Password";
    bool submitted = ViewBag.Submitted ?? false;
}

<div class="page page--auth">
    <div class="auth-card" style="text-align:center;">
        <div style="margin:0 auto 14px; display:inline-block;">
            <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "180" }, { "LogoClass", "brand-logo brand-logo--plain" } }' />
        </div>
        <h1 class="headline-md" style="margin-bottom:20px;">FORGOT PASSWORD</h1>

        <div style="text-align:left; margin-top:8px;">
        @if (submitted)
        {
            <div class="card" style="background:#fffbeb; border-color:#fed7aa; padding:16px; margin-bottom:16px;">
                <p style="font-size:13.5px; color:#9a3412; margin:0; line-height:1.5;">
                    If that email belongs to an authorized staff account, we have sent a secure password reset link.
                    The link is active for 5 minutes. Please check your inbox.
                </p>
            </div>

            <p style="margin-top:20px; text-align:center;">
                <a asp-action="Login" class="btn btn-outline btn-block">Back to Login</a>
            </p>
        }
        else
        {
            <p class="text-muted" style="font-size:13.5px; margin-bottom:20px; line-height:1.5;">
                Enter your staff email address and we'll dispatch a link to reset your account password.
            </p>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="email">Staff Email</label>
                    <input type="email" id="email" name="email" value="@ViewBag.Email" placeholder="staff@restaurant.com" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary btn-block" style="padding:12px; margin-top:8px; font-size:15px; font-weight:600;">
                    Send Reset Link
                </button>
            </form>

            <p style="margin-top:16px; text-align:center;">
                <a asp-action="Login" style="font-size:13px; color:var(--on-surface-variant); text-decoration:underline;">
                    &larr; Back to login
                </a>
            </p>
        }
        </div>
    </div>
</div>
