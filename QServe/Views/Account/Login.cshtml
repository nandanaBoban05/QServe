@{
    ViewData["Title"] = "Staff Login";
}

<div class="page page--auth">
    <div class="auth-card" style="text-align:center;">
        <div style="margin:0 auto 14px; display:inline-block;">
            <partial name="_Logo" view-data='@new ViewDataDictionary(ViewData) { { "LogoWidth", "68" }, { "LogoHeight", "68" }, { "LogoClass", "brand-logo brand-logo--plain" } }' />
        </div>
        <h1 class="headline-md" style="margin-bottom:2px;">QServe</h1>
        <span class="eyebrow" style="margin-bottom:24px;">Smart Restaurant Management</span>

        <div style="text-align:left;">
            @if (TempData["LoginMessage"] is string loginMessage)
            {
                <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
                    <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@loginMessage</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary-errors">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="email">Staff Email</label>
                    <input type="email" id="email" name="email" placeholder="staff@restaurant.com" required autofocus />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-primary btn-block" style="padding:12px; margin-top:8px; font-size:15px; font-weight:600;">
                    Log In to Dashboard
                </button>
            </form>

            <p style="text-align:center; margin-top:16px;">
                <a asp-controller="Account" asp-action="ForgotPassword" style="font-size:13px; color:var(--on-surface-variant); text-decoration:underline;">
                    Forgot your password?
                </a>
            </p>
        </div>
    </div>
</div>
