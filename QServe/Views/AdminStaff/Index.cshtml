@model List<QServe.Models.User>
@{
    ViewData["Title"] = "Staff Accounts";
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Admin Only</span>
            <h1>Staff Accounts</h1>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ New Staff</a>
    </div>

    @if (TempData["StaffMessage"] is string message)
    {
        <div class="card" style="background:var(--curry-tint); border-color:#b9caae; padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px;">@message</span>
        </div>
    }

    <div class="card">
        <table class="data-table">
            <thead>
                <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTime.UtcNow;
                <tr class="@(user.IsActive ? "" : "is-dim")">
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge badge-steel">@user.Role</span></td>
                    <td>
                        <span class="badge @(user.IsActive ? "badge-curry" : "badge-tamarind")">@(user.IsActive ? "Active" : "Deactivated")</span>
                        @if (isLocked)
                        {
                            <span class="badge badge-tamarind">Locked until @user.LockoutEnd!.Value.ToString("HH:mm")</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-userId="@user.UserID" class="btn-ghost">Edit</a>
                        <a asp-action="ResetPassword" asp-route-userId="@user.UserID" class="btn-ghost">Reset Password</a>
                        @if (isLocked)
                        {
                            <form asp-action="ClearLockout" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.UserID" />
                                <button type="submit" class="btn-ghost" style="border:none; background:none; cursor:pointer;">Clear Lockout</button>
                            </form>
                        }
                        <form asp-action="ToggleActive" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.UserID" />
                            <button type="submit" class="btn-ghost" style="border:none; background:none; cursor:pointer;">
                                @(user.IsActive ? "Deactivate" : "Reactivate")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
