@{
    ViewData["Title"] = "Reset Password";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <span class="eyebrow">Admin Only</span>
    <h1>Reset Password</h1>
    <p class="text-muted" style="font-size:13.5px;">For <strong>@ViewBag.FullName</strong>. Share the new password with them directly — this does not send an email.</p>

    <div class="card mt-lg">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="ResetPassword" asp-route-userId="@ViewBag.UserId" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>New temporary password</label>
                <input type="text" name="newPassword" required minlength="8" placeholder="At least 8 characters" />
            </div>

            <button type="submit" class="btn btn-primary btn-block">Set New Password</button>
        </form>
    </div>
</div>
