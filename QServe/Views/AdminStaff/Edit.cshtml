@model QServe.Models.User
@{
    ViewData["Title"] = "Edit Staff Account";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <div class="page-head">
        <div>
            <a asp-action="Index" class="btn btn-ghost btn-sm" style="margin-bottom:8px; padding-left:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to Staff List
            </a>
            <span class="eyebrow" style="display:block;">Access Control</span>
            <h1 class="headline-lg">EDIT: @Model.FullName.ToUpper()</h1>
        </div>
    </div>

    <div class="card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Edit" asp-route-userId="@Model.UserID" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Full Name <span style="color:var(--error);">*</span></label>
                <input type="text" name="fullName" value="@Model.FullName" required />
                @if (ViewData.ModelState["fullName"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["fullName"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label>Email Address <span style="color:var(--error);">*</span></label>
                <input type="email" name="email" value="@Model.Email" required />
                @if (ViewData.ModelState["email"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["email"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label>Role <span style="color:var(--error);">*</span></label>
                <select name="role" required>
                    @foreach (var r in new[] { "Kitchen", "Manager", "Admin" })
                    {
                        <option value="@r" selected="@(r == Model.Role)">@r</option>
                    }
                </select>
                @if (ViewData.ModelState["role"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["role"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <p class="text-muted" style="font-size:12px; margin-top:8px;">
                To reset this staff account's password, use the Reset Password action in the staff table.
            </p>

            <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--surface-container-high); display:flex; gap:12px; justify-content:flex-end;">
                <a asp-action="Index" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary" style="padding:10px 24px;">Save Changes</button>
            </div>
        </form>
    </div>
</div>
