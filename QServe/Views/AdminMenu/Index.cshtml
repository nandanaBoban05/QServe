@model QServe.ViewModels.AdminMenuFilterViewModel
@{
    ViewData["Title"] = "Menu Items";
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Menu Management</span>
            <h1 class="headline-lg">MENU ITEMS</h1>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <span class="text-muted mono" style="font-size:13.5px;">Total: <strong>@Model.Items.TotalCount</strong> items</span>
            <a asp-action="CreateItem" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                + Add Menu Item
            </a>
        </div>
    </div>

    @if (TempData["MenuSuccess"] is string successMessage)
    {
        <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@successMessage</span>
        </div>
    }
    @if (TempData["MenuError"] is string errorMessage)
    {
        <div class="card" style="background:#fef2f2; border-color:#fee2e2; padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--error); font-weight:500;">@errorMessage</span>
        </div>
    }

    <!-- Standardized Filter Card -->
    <div class="filter-card">
        <form method="get" asp-action="Index">
            <div class="filter-grid" style="grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Search Item</label>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Name, description..." />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Category</label>
                    <select name="CategoryId">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryID" selected="@(Model.CategoryId == cat.CategoryID ? "selected" : null)">
                                @cat.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Item Type</label>
                    <select name="ItemType">
                        <option value="All" selected="@(Model.ItemType == "All" || string.IsNullOrEmpty(Model.ItemType) ? "selected" : null)">All Types</option>
                        <option value="Quick" selected="@(Model.ItemType == "Quick" ? "selected" : null)">Quick</option>
                        <option value="Cooked" selected="@(Model.ItemType == "Cooked" ? "selected" : null)">Cooked</option>
                        <option value="Beverage" selected="@(Model.ItemType == "Beverage" ? "selected" : null)">Beverage</option>
                        <option value="Dessert" selected="@(Model.ItemType == "Dessert" ? "selected" : null)">Dessert</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Availability</label>
                    <select name="Availability">
                        <option value="All" selected="@(Model.Availability == "All" || string.IsNullOrEmpty(Model.Availability) ? "selected" : null)">All</option>
                        <option value="Available" selected="@(Model.Availability == "Available" ? "selected" : null)">Available Only</option>
                        <option value="Unavailable" selected="@(Model.Availability == "Unavailable" ? "selected" : null)">Unavailable Only</option>
                    </select>
                </div>

                <div class="filter-actions">
                    <a asp-action="Index" class="btn btn-secondary" style="height:38px; padding:0 18px;">Reset</a>
                    <button type="submit" class="btn btn-primary" style="height:38px; padding:0 22px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filter
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Items Table Card -->
    <div class="card" style="padding:0; overflow:hidden;">
    @if (!Model.Items.Items.Any())
    {
        <div class="empty-state">
            <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <p class="empty-state-text">No menu items match the selected criteria.</p>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Reset Filters</a>
        </div>
    }
    else
    {
        <div class="data-table-container" style="border:none; border-radius:0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item Details</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Prep Time</th>
                        <th>Availability</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items.Items)
                {
                    <tr class="@(item.IsAvailable ? "" : "is-dim")">
                        <td>
                            <strong style="color:var(--on-surface); font-size:14.5px;">@item.Name</strong>
                        </td>
                        <td>@(item.Category?.Name ?? "Uncategorized")</td>
                        <td><span class="badge badge-neutral">@item.ItemType</span></td>
                        <td class="num font-weight-bold" style="color:var(--primary); font-size:14.5px;">₹@item.Price.ToString("0.00")</td>
                        <td class="num">@item.PrepTimeMinutes min</td>
                        <td>
                            <span class="badge @(item.IsAvailable ? "badge-ready" : "badge-cancelled")">
                                @(item.IsAvailable ? "Available" : "Unavailable")
                            </span>
                        </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <form asp-action="ToggleAvailability" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@item.ItemID" />
                                        <button type="submit" class="btn btn-ghost btn-sm" style="padding:4px 8px;">
                                            @(item.IsAvailable ? "Mark Unavailable" : "Mark Available")
                                        </button>
                                    </form>
                                    <a asp-action="EditItem" asp-route-itemId="@item.ItemID" class="btn btn-outline btn-sm" style="padding:4px 10px;">
                                        Edit
                                    </a>
                                    <button type="button" class="btn btn-outline btn-sm" style="padding:4px 10px; color:var(--error); border-color:#fecaca;"
                                            onclick="openDeleteItemModal('@item.ItemID', '@item.Name')">
                                        Delete
                                    </button>
                                </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model.Items" />
    }
    </div>
</div>

<!-- Modal for Delete Menu Item Confirmation -->
<div id="deleteItemModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center; padding:16px;">
    <div class="card" style="max-width:440px; width:100%; box-shadow:var(--shadow-lg); border-radius:var(--radius-xl); animation:popIn 0.2s ease-out; text-align:center; padding:24px;">
        <div style="width:48px; height:48px; border-radius:50%; background:#fee2e2; color:var(--error); display:inline-flex; align-items:center; justify-content:center; margin:0 auto 16px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
        </div>
        <h3 style="margin:0 0 8px 0; font-size:18px; color:var(--on-surface);">DELETE MENU ITEM</h3>
        <p style="font-size:14px; color:var(--on-surface-variant); margin-bottom:20px; line-height:1.5;">
            Are you sure you want to delete <strong id="deleteItemName" style="color:var(--on-surface);">this menu item</strong>? This action cannot be undone.
        </p>
        <form asp-action="DeleteItem" method="post" id="deleteItemForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="itemId" id="deleteItemId" value="" />
            <div style="display:flex; justify-content:center; gap:12px;">
                <button type="button" class="btn btn-outline" onclick="closeDeleteItemModal()" style="padding:8px 20px;">Cancel</button>
                <button type="submit" class="btn btn-danger" style="padding:8px 20px;">Delete</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openDeleteItemModal(itemId, itemName) {
        document.getElementById('deleteItemId').value = itemId;
        document.getElementById('deleteItemName').textContent = '"' + itemName + '"';
        document.getElementById('deleteItemModal').style.display = 'flex';
    }

    function closeDeleteItemModal() {
        document.getElementById('deleteItemModal').style.display = 'none';
    }
</script>
