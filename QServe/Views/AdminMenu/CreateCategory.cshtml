@model QServe.Models.MenuCategory
@{
    ViewData["Title"] = "Add New Category";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <div class="page-head">
        <div>
            <a asp-action="Categories" class="btn btn-ghost btn-sm" style="margin-bottom:8px; padding-left:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to Categories
            </a>
            <span class="eyebrow" style="display:block;">Menu Organization</span>
            <h1 class="headline-lg">ADD NEW CATEGORY</h1>
        </div>
    </div>

    <div class="card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="CreateCategory" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Category Name <span style="color:var(--error);">*</span></label>
                <input type="text" name="Name" value="@Model?.Name" placeholder="e.g. Desserts, Chef Specials" required autofocus />
                @if (ViewData.ModelState["Name"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["Name"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label>Display Order (Priority) <span style="color:var(--error);">*</span></label>
                <input type="number" name="DisplayOrder" value="@(Model?.DisplayOrder > 0 ? Model.DisplayOrder : 1)" min="1" max="99" required />
                @if (ViewData.ModelState["DisplayOrder"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["DisplayOrder"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--surface-container-high); display:flex; gap:12px; justify-content:flex-end;">
                <a asp-action="Categories" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary" style="padding:10px 24px;">+ Create Category</button>
            </div>
        </form>
    </div>
</div>
