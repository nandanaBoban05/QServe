@model QServe.Models.MenuItem
@{
    ViewData["Title"] = "New Menu Item";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <span class="eyebrow">Menu</span>
    <h1>New Item</h1>

    <div class="card mt-lg">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="CreateItem" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Name</label>
                <input type="text" name="Name" required />
            </div>

            <div class="form-group">
                <label>Category</label>
                <select name="CategoryID" required>
                    @foreach (var category in (List<QServe.Models.MenuCategory>)ViewBag.Categories)
                    {
                        <option value="@category.CategoryID">@category.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Item Type <span class="text-muted" style="text-transform:none; font-weight:400;">— feeds the kitchen priority classifier</span></label>
                <select name="ItemType" required>
                    <option value="Beverage">Beverage</option>
                    <option value="Quick">Quick</option>
                    <option value="Cooked">Cooked</option>
                    <option value="Dessert">Dessert</option>
                </select>
            </div>

            <div class="field-row">
                <div class="form-group" style="flex:1;">
                    <label>Price (₹)</label>
                    <input type="number" name="Price" step="0.01" min="0.01" required />
                </div>
                <div class="form-group" style="flex:1;">
                    <label>Prep Time (min)</label>
                    <input type="number" name="PrepTimeMinutes" value="10" min="1" />
                </div>
            </div>

            <div class="form-group">
                <label>Image URL (optional)</label>
                <input type="text" name="ImageUrl" />
            </div>

            <button type="submit" class="btn btn-primary btn-block">Create Item</button>
        </form>
    </div>
</div>
