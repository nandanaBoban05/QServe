@model QServe.Models.MenuItem
@{
    ViewData["Title"] = "New Menu Item";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <div class="page-head">
        <div>
            <a asp-action="Index" class="btn btn-ghost btn-sm" style="margin-bottom:8px; padding-left:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to Menu Items
            </a>
            <span class="eyebrow" style="display:block;">Menu Catalog</span>
            <h1 class="headline-lg">ADD NEW ITEM</h1>
        </div>
    </div>

    <div class="card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="CreateItem" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Item Name <span style="color:var(--error);">*</span></label>
                <input type="text" name="Name" value="@Model?.Name" placeholder="e.g. Butter Chicken Burger" required autofocus />
                @if (ViewData.ModelState["Name"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["Name"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label>Category <span style="color:var(--error);">*</span></label>
                <select name="CategoryID" required>
                    @foreach (var category in (List<QServe.Models.MenuCategory>)ViewBag.Categories)
                    {
                        <option value="@category.CategoryID" selected="@(Model?.CategoryID == category.CategoryID ? "selected" : null)">@category.Name</option>
                    }
                </select>
                @if (ViewData.ModelState["CategoryID"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["CategoryID"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label>Item Type <span style="color:var(--error);">*</span> <span class="text-muted" style="text-transform:none; font-weight:400;">— drives kitchen queue priority classification</span></label>
                <select name="ItemType" required>
                    <option value="Beverage">Beverage</option>
                    <option value="Quick">Quick (&le;10 min prep)</option>
                    <option value="Cooked">Cooked (Main kitchen course)</option>
                    <option value="Dessert">Dessert</option>
                </select>
                @if (ViewData.ModelState["ItemType"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["ItemType"]!.Errors.First().ErrorMessage</span>
                }
            </div>

            <div class="field-row">
                <div class="form-group" style="flex:1;">
                    <label>Unit Price (₹) <span style="color:var(--error);">*</span></label>
                    <input type="number" name="Price" value="@(Model?.Price > 0 ? Model.Price.ToString("0.00") : "")" step="0.01" min="0.01" placeholder="250.00" required />
                    @if (ViewData.ModelState["Price"]?.Errors.Any() == true)
                    {
                        <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["Price"]!.Errors.First().ErrorMessage</span>
                    }
                </div>
                <div class="form-group" style="flex:1;">
                    <label>Estimated Prep Time (minutes)</label>
                    <input type="number" name="PrepTimeMinutes" value="@(Model?.PrepTimeMinutes > 0 ? Model.PrepTimeMinutes : 10)" min="0" />
                    @if (ViewData.ModelState["PrepTimeMinutes"]?.Errors.Any() == true)
                    {
                        <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["PrepTimeMinutes"]!.Errors.First().ErrorMessage</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Item Image (optional)</label>
                <input type="file" id="itemImageInput" name="imageFile" accept="image/png, image/jpeg, image/webp, image/gif" onchange="handleImagePreview(this)" />
                <span class="text-muted" style="font-size:12px; display:block; margin-top:4px;">JPG, PNG, WEBP or GIF — up to 5 MB.</span>
                @if (ViewData.ModelState["ImageUrl"]?.Errors.Any() == true)
                {
                    <span class="text-danger" style="font-size:12.5px; margin-top:4px; display:block;">@ViewData.ModelState["ImageUrl"]!.Errors.First().ErrorMessage</span>
                }

                <!-- Live Instant Preview Container -->
                <div id="imagePreviewWrapper" style="display:none; margin-top:14px; padding:12px 14px; border:1px dashed var(--outline-variant); border-radius:var(--radius-md); background:var(--surface-container-lowest); width:fit-content;">
                    <span class="label-md" style="display:block; margin-bottom:8px; font-size:12px; color:var(--on-surface-variant); font-weight:600;">Selected Image Preview:</span>
                    <div style="display:flex; align-items:center; gap:14px;">
                        <img id="imagePreview" src="#" alt="Selected Preview" style="width:96px; height:96px; border-radius:8px; object-fit:cover; border:1px solid var(--outline-subtle); display:block;" />
                        <div>
                            <span id="imageFileName" style="font-size:13px; font-weight:600; display:block; color:var(--on-surface);"></span>
                            <span id="imageFileSize" class="text-muted" style="font-size:12px; display:block; margin-top:2px;"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--surface-container-high); display:flex; gap:12px; justify-content:flex-end;">
                <a asp-action="Index" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary" style="padding:10px 24px;">+ Create Menu Item</button>
            </div>
        </form>
    </div>
</div>

<script>
    function handleImagePreview(input) {
        const wrapper = document.getElementById('imagePreviewWrapper');
        const img = document.getElementById('imagePreview');
        const nameEl = document.getElementById('imageFileName');
        const sizeEl = document.getElementById('imageFileSize');

        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            if (file.size > 5 * 1024 * 1024) {
                alert("File size exceeds 5MB. Please choose a smaller image.");
                input.value = "";
                wrapper.style.display = 'none';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                img.src = e.target.result;
                nameEl.textContent = file.name;
                sizeEl.textContent = (file.size / 1024).toFixed(1) + " KB";
                wrapper.style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            wrapper.style.display = 'none';
        }
    }
</script>
