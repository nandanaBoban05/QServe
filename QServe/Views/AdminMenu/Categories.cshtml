@model QServe.ViewModels.AdminCategoryFilterViewModel
@{
    ViewData["Title"] = "Menu Categories";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <div class="page-head">
        <div>
            <span class="eyebrow">Menu Organization</span>
            <h1 class="headline-lg">MENU CATEGORIES</h1>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <span class="mono text-muted" style="font-size:13.5px;">Total: <strong style="color:var(--on-surface);">@Model.Categories.TotalCount</strong> sections</span>
            <a asp-action="CreateCategory" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add Category
            </a>
        </div>
    </div>

    @if (TempData["CategoryError"] is string error)
    {
        <div class="card" style="background:#fef2f2; border-color:#fee2e2; padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--error); font-weight:500;">@error</span>
        </div>
    }
    @if (TempData["CategorySuccess"] is string success)
    {
        <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@success</span>
        </div>
    }

    <!-- Standardized Search & Filter Bar -->
    <div class="filter-card">
        <form method="get" asp-action="Categories">
            <div class="filter-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Search Category</label>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Category name..." />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label>Status</label>
                    <select name="Status">
                        <option value="All" selected="@(Model.Status == "All" || string.IsNullOrEmpty(Model.Status) ? "selected" : null)">All Categories</option>
                        <option value="Active" selected="@(Model.Status == "Active" ? "selected" : null)">Active Only</option>
                        <option value="Hidden" selected="@(Model.Status == "Hidden" ? "selected" : null)">Hidden Only</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <a asp-action="Categories" class="btn btn-secondary" style="height:38px; padding:0 18px;">Reset</a>
                    <button type="submit" class="btn btn-primary" style="height:38px; padding:0 22px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filter
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
        <div class="data-table-container" style="border:none; border-radius:0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Items Count</th>
                        <th>Display Order</th>
                        <th>Status</th>
                        <th style="text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Categories.Items.Any())
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                    <polyline points="2 17 12 22 22 17"></polyline>
                                    <polyline points="2 12 12 17 22 12"></polyline>
                                </svg>
                                <p class="empty-state-text">No categories match the criteria.</p>
                                <a asp-action="Categories" class="btn btn-secondary btn-sm">Reset Filters</a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model.Categories.Items)
                    {
                        var itemCount = category.Items?.Count ?? 0;

                        <tr class="@(category.IsActive ? "" : "is-dim")" id="cat-view-@category.CategoryID">
                            <td><strong style="color:var(--on-surface); font-size:14.5px;">@category.Name</strong></td>
                            <td class="num">@itemCount items</td>
                            <td class="num">@category.DisplayOrder</td>
                            <td>
                                <span class="badge @(category.IsActive ? "badge-ready" : "badge-neutral")">
                                    @(category.IsActive ? "Active" : "Hidden")
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex; gap:6px; flex-wrap:wrap; justify-content:flex-end;">
                                    <button type="button" class="btn btn-outline btn-sm" style="padding:4px 10px;"
                                            onclick="qserveToggleCategoryEdit(@category.CategoryID)">
                                        Edit
                                    </button>

                                    <form asp-action="ToggleCategoryActive" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                        <button type="submit" class="btn btn-outline btn-sm" style="padding:4px 10px;">
                                            @(category.IsActive ? "Hide Section" : "Show Section")
                                        </button>
                                    </form>

                                    <form asp-action="DeleteCategory" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete category &quot;@category.Name&quot;? This cannot be undone.@(itemCount > 0 ? " It currently has " + itemCount + " item(s), so this will be blocked until they are moved or removed." : "")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                        <button type="submit" class="btn btn-outline btn-sm" style="padding:4px 10px; color:var(--error); border-color:#fecaca;">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <tr id="cat-edit-@category.CategoryID" class="cat-edit-row" style="display:none;">
                            <td colspan="5" style="background:var(--surface-container-lowest); padding:14px 16px; border-top:1px dashed var(--outline-subtle);">
                                <form asp-action="EditCategory" method="post" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                    <div class="form-group" style="margin-bottom:0; flex:1; min-width:180px;">
                                        <label>Category Name</label>
                                        <input type="text" name="name" value="@category.Name" required />
                                    </div>
                                    <div class="form-group" style="margin-bottom:0; width:140px;">
                                        <label>Display Order</label>
                                        <input type="number" name="displayOrder" value="@category.DisplayOrder" min="1" max="99" required />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm" style="padding:0 18px; height:38px;">Save</button>
                                    <button type="button" class="btn btn-secondary btn-sm" style="padding:0 18px; height:38px;"
                                            onclick="qserveToggleCategoryEdit(@category.CategoryID)">
                                        Cancel
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model.Categories" />
    </div>
</div>

<script>
    // UI-only: toggles the inline edit row for a category between hidden/visible.
    // Doesn't touch any data — actual saving happens via the normal POST form to EditCategory.
    function qserveToggleCategoryEdit(categoryId) {
        var editRow = document.getElementById('cat-edit-' + categoryId);
        if (!editRow) return;
        var isVisible = editRow.style.display !== 'none';
        editRow.style.display = isVisible ? 'none' : 'table-row';
    }
</script>