@model List<QServe.Models.MenuCategory>
@{
    ViewData["Title"] = "Menu Categories";
}

<partial name="_AdminNav" />

<div class="page page--narrow">
    <span class="eyebrow">Menu</span>
    <h1>Categories</h1>

    <div class="card mt-lg">
        <table class="data-table">
            <thead>
                <tr><th>Name</th><th>Order</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
            @foreach (var category in Model)
            {
                <tr class="@(category.IsActive ? "" : "is-dim")">
                    <td>@category.Name</td>
                    <td class="num">@category.DisplayOrder</td>
                    <td><span class="badge @(category.IsActive ? "badge-curry" : "badge-steel")">@(category.IsActive ? "Active" : "Hidden")</span></td>
                    <td>
                        <form asp-action="ToggleCategoryActive" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="categoryId" value="@category.CategoryID" />
                            <button type="submit" class="btn-ghost" style="border:none; background:none; cursor:pointer;">
                                @(category.IsActive ? "Hide" : "Show")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="card mt-lg">
        <h3 style="margin-bottom:14px;">Add a category</h3>
        <form asp-action="CreateCategory" method="post" class="field-row">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:0; flex:1;">
                <label>Name</label>
                <input type="text" name="name" required />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label>Display order</label>
                <input type="number" name="displayOrder" value="0" style="width:90px;" />
            </div>
            <button type="submit" class="btn btn-primary">Add Category</button>
        </form>
    </div>
</div>
