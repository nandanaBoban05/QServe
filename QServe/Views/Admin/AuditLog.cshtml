@model List<QServe.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    int currentPage = ViewBag.CurrentPage;
    bool hasNext = ViewBag.HasNextPage;
    bool hasPrev = ViewBag.HasPrevPage;
    int totalCount = ViewBag.TotalCount;
}

<partial name="_AdminNav" />

<div class="page">
    <span class="eyebrow">Accountability</span>
    <h1>Audit Log</h1>
    <p class="text-muted" style="font-size:13px; margin-top:-8px;">
        Every recorded state change across the system — @totalCount total entries.
    </p>

    <div class="card">
    @if (!Model.Any())
    {
        <p class="kds-empty">No audit entries yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>When</th><th>Entity</th><th>Action</th><th>By</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td class="num" style="white-space:nowrap;">@log.Timestamp.ToString("MMM d, HH:mm:ss")</td>
                    <td><span class="badge badge-steel">@log.EntityType</span> <span class="num text-muted">#@log.EntityID</span></td>
                    <td>@log.Action</td>
                    <td>@(log.PerformedByUser?.FullName ?? "System")</td>
                    <td style="max-width:320px; font-size:11.5px; color:var(--ink-faint);">
                        @if (!string.IsNullOrEmpty(log.NewValue))
                        {
                            <span class="mono">@log.NewValue</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="flex-between mt-lg">
            <a class="btn btn-outline btn-sm @(hasPrev ? "" : "disabled")"
                   href="@(hasPrev ? Url.Action("AuditLog", new { page = currentPage - 1 }) : "#")"
               style="@(hasPrev ? "" : "opacity:0.4; pointer-events:none;")">← Newer</a>
                <span class="text-muted mono" style="font-size:12px;">Page @currentPage</span>
            <a class="btn btn-outline btn-sm"
                   href="@(hasNext ? Url.Action("AuditLog", new { page = currentPage + 1 }) : "#")"
               style="@(hasNext ? "" : "opacity:0.4; pointer-events:none;")">Older →</a>
        </div>
    }
    </div>
</div>
