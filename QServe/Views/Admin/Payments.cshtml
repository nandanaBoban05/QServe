@model QServe.ViewModels.AdminPaymentFilterViewModel
@{
    ViewData["Title"] = "Payment Management";
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Financials</span>
            <h1>Payment Management</h1>
        </div>
        <div class="mono text-muted" style="font-size:13px;">
            Total: <strong>@Model.Payments.TotalCount</strong> records
        </div>
    </div>

    @if (TempData["PaymentMessage"] is string message)
    {
        <div class="card" style="background:var(--curry-tint); border-color:#b9caae; padding:10px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px;">@message</span>
        </div>
    }

    <!-- Filter Form -->
    <div class="card" style="margin-bottom:20px; padding:18px 20px;">
        <form method="get" asp-action="Payments">
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:12px; align-items:flex-end;">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Search</label>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Table, Order #, Pay ID..." />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Status</label>
                    <select name="PaymentStatus">
                        <option value="All" selected="@(Model.PaymentStatus == "All" || string.IsNullOrEmpty(Model.PaymentStatus) ? "selected" : null)">All Statuses</option>
                        <option value="Pending" selected="@(Model.PaymentStatus == "Pending" ? "selected" : null)">Pending</option>
                        <option value="Processing" selected="@(Model.PaymentStatus == "Processing" ? "selected" : null)">Processing</option>
                        <option value="Received" selected="@(Model.PaymentStatus == "Received" ? "selected" : null)">Received</option>
                        <option value="Failed" selected="@(Model.PaymentStatus == "Failed" ? "selected" : null)">Failed</option>
                        <option value="Refunded" selected="@(Model.PaymentStatus == "Refunded" ? "selected" : null)">Refunded</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Mode</label>
                    <select name="PaymentMode">
                        <option value="All" selected="@(Model.PaymentMode == "All" || string.IsNullOrEmpty(Model.PaymentMode) ? "selected" : null)">All Modes</option>
                        <option value="Online" selected="@(Model.PaymentMode == "Online" ? "selected" : null)">Online (Razorpay)</option>
                        <option value="Cash" selected="@(Model.PaymentMode == "Cash" ? "selected" : null)">Cash</option>
                        <option value="Card" selected="@(Model.PaymentMode == "Card" ? "selected" : null)">Card (POS)</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Min ₹</label>
                    <input type="number" step="0.01" name="MinAmount" value="@Model.MinAmount" placeholder="0.00" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Max ₹</label>
                    <input type="number" step="0.01" name="MaxAmount" value="@Model.MaxAmount" placeholder="10000.00" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>From</label>
                    <input type="date" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>To</label>
                    <input type="date" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div style="display:flex; gap:6px;">
                    <button type="submit" class="btn btn-primary btn-sm" style="height:40px; flex:1;">Filter</button>
                    <a asp-action="Payments" class="btn btn-outline btn-sm" style="height:40px; padding:0 12px; display:inline-flex; align-items:center;">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Payments Table -->
    <div class="card">
    @if (!Model.Payments.Items.Any())
    {
        <p class="kds-empty">No payments match the selected filters.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Pay ID</th>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Mode</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Timestamp</th>
                        <th>Verified By</th>
                        <th style="text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var payment in Model.Payments.Items)
                {
                    <tr>
                        <td class="num">#@payment.PaymentID</td>
                        <td class="num">
                            <a asp-action="OrderDetails" asp-route-id="@payment.OrderID" style="font-weight:600; text-decoration:underline;">
                                #@payment.OrderID.ToString("D5")
                            </a>
                        </td>
                        <td>Table @(payment.Order?.Table?.TableNumber ?? "-")</td>
                        <td><span class="badge badge-steel">@payment.PaymentMode</span></td>
                        <td>
                            <span class="badge @(payment.PaymentStatus == "Received" ? "badge-curry" : payment.PaymentStatus == "Refunded" || payment.PaymentStatus == "Failed" ? "badge-tamarind" : "badge-turmeric")">
                                @payment.PaymentStatus
                            </span>
                        </td>
                        <td class="num" style="font-weight:700;">₹@payment.Amount.ToString("0.00")</td>
                        <td class="num" style="font-size:12.5px;">
                            @((payment.VerificationTime ?? payment.CreatedAt).ToString("MMM d, HH:mm"))
                        </td>
                        <td style="font-size:12px;">
                            @(payment.VerifiedByUser?.FullName ?? (payment.PaymentMode == "Online" ? "Gateway" : "-"))
                        </td>
                        <td style="text-align:right;">
                            @if (payment.PaymentStatus == "Received")
                            {
                                <form asp-action="RefundPayment" method="post" style="display:inline;"
                                      onsubmit="return confirm('Refund ₹@payment.Amount.ToString("0.00") for Order #@payment.OrderID?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="paymentId" value="@payment.PaymentID" />
                                    <button type="submit" class="btn btn-outline btn-sm">Refund</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:12px;">-</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model.Payments" />
    }
    </div>
</div>
