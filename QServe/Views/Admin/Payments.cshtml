@model QServe.ViewModels.AdminPaymentFilterViewModel
@{
    ViewData["Title"] = "Payment Management";
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Financials</span>
            <h1 class="headline-lg">PAYMENT RECORDS</h1>
        </div>
        <div class="mono text-muted" style="font-size:13.5px;">
            Total: <strong style="color:var(--on-surface);">@Model.Payments.TotalCount</strong> records
        </div>
    </div>

    @if (TempData["PaymentMessage"] is string message)
    {
        <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@message</span>
        </div>
    }

    <!-- Standardized Filter Card -->
    <div class="filter-card">
        <form method="get" asp-action="Payments">
            <div class="filter-grid" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Search Query</label>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Table, Order #, Pay ID..." />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Payment Status</label>
                    <select name="PaymentStatus">
                        <option value="All" selected="@(Model.PaymentStatus == "All" || string.IsNullOrEmpty(Model.PaymentStatus) ? "selected" : null)">All Statuses</option>
                        <option value="Pending" selected="@(Model.PaymentStatus == "Pending" ? "selected" : null)">Pending</option>
                        <option value="Processing" selected="@(Model.PaymentStatus == "Processing" ? "selected" : null)">Processing</option>
                        <option value="Received" selected="@(Model.PaymentStatus == "Received" ? "selected" : null)">Received</option>
                        <option value="Failed" selected="@(Model.PaymentStatus == "Failed" ? "selected" : null)">Failed</option>
                        <option value="Refunded" selected="@(Model.PaymentStatus == "Refunded" ? "selected" : null)">Refunded</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Payment Mode</label>
                    <select name="PaymentMode">
                        <option value="All" selected="@(Model.PaymentMode == "All" || string.IsNullOrEmpty(Model.PaymentMode) ? "selected" : null)">All Modes</option>
                        <option value="Online" selected="@(Model.PaymentMode == "Online" ? "selected" : null)">Online (Razorpay)</option>
                        <option value="Cash" selected="@(Model.PaymentMode == "Cash" ? "selected" : null)">Cash</option>
                        <option value="Card" selected="@(Model.PaymentMode == "Card" ? "selected" : null)">Card (POS)</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Min Amount (₹)</label>
                    <input type="number" step="0.01" name="MinAmount" value="@Model.MinAmount" placeholder="0.00" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Max Amount (₹)</label>
                    <input type="number" step="0.01" name="MaxAmount" value="@Model.MaxAmount" placeholder="10000.00" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>From Date</label>
                    <input type="date" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>To Date</label>
                    <input type="date" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="filter-actions">
                    <a asp-action="Orders" class="btn btn-secondary">Reset</a>
                    <button type="submit" class="btn btn-primary">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filter
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Payments Table Card -->
    <div class="card" style="padding:0; overflow:hidden;">
    @if (!Model.Payments.Items.Any())
    {
        <div class="empty-state">
            <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <p class="empty-state-text">No payment records matching the selected filters.</p>
            <a asp-action="Payments" class="btn btn-secondary btn-sm">Reset Filters</a>
        </div>
    }
    else
    {
        <div class="data-table-container" style="border:none; border-radius:0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Pay ID</th>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Mode</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Time (UTC)</th>
                        <th>Verified By</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var payment in Model.Payments.Items)
                {
                    <tr>
                        <td class="num font-weight-bold">#@payment.PaymentID</td>
                        <td class="num">
                            <a asp-action="OrderDetails" asp-route-id="@payment.OrderID" style="font-weight:700; color:var(--primary); text-decoration:none;">
                                #@payment.OrderID.ToString("D5")
                            </a>
                        </td>
                        <td><strong style="color:var(--on-surface);">Table @(payment.Order?.Table?.TableNumber ?? "-")</strong></td>
                        <td><span class="badge badge-neutral">@payment.PaymentMode</span></td>
                        <td class="num" style="font-weight:700; font-size:14.5px; color:var(--on-surface);">₹@payment.Amount.ToString("0.00")</td>
                        <td>
                            @{
                                string badgeClass = payment.PaymentStatus switch {
                                    "Received" => "badge-ready",
                                    "Refunded" => "badge-cancelled",
                                    "Failed" => "badge-cancelled",
                                    "Processing" => "badge-awaiting",
                                    _ => "badge-pending"
                                };
                            }
                            <span class="badge @badgeClass">@payment.PaymentStatus</span>
                        </td>
                        <td class="num text-muted" style="font-size:12.5px;">@payment.CreatedAt.ToIstString("MMM d, h:mm tt")</td>
                        <td>
                            @if (payment.VerifiedByUser != null)
                            {
                                <span style="font-size:12.5px; font-weight:500;">@payment.VerifiedByUser.FullName</span>
                            }
                            else if (payment.PaymentMode == "Online")
                            {
                                <span class="text-muted" style="font-size:12px;">Razorpay Gateway</span>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:12px;">Pending Check</span>
                            }
                        </td>
                        <td style="text-align:right; white-space:nowrap;">
                            <a asp-action="OrderDetails" asp-route-id="@payment.OrderID" class="btn btn-secondary btn-sm" style="padding:4px 10px; font-weight:600;">
                                View Order &rarr;
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model.Payments" />
    }
    </div>
</div>
