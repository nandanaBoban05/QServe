@model QServe.ViewModels.AdminTableFilterViewModel
@{
    ViewData["Title"] = "Tables & QR Codes";
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Floor Management</span>
            <h1 class="headline-lg">Tables &amp; QR Codes</h1>
        </div>
        <div class="mono text-muted" style="font-size:13.5px;">
            Total: <strong style="color:var(--on-surface);">@Model.Tables.TotalCount</strong> tables
        </div>
    </div>

    @if (TempData["TableError"] is string errorMessage)
    {
        <div class="card" style="background:#fef2f2; border-color:#fee2e2; padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--error); font-weight:500;">@errorMessage</span>
        </div>
    }
    @if (TempData["TableSuccess"] is string successMessage)
    {
        <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@successMessage</span>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="filter-card">
        <form method="get" asp-action="Tables">
            <div class="filter-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Search Table</label>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Table number..." />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label>Status</label>
                    <select name="Status">
                        <option value="All" selected="@(Model.Status == "All" || string.IsNullOrEmpty(Model.Status) ? "selected" : null)">All Tables</option>
                        <option value="Active" selected="@(Model.Status == "Active" ? "selected" : null)">Active Only</option>
                        <option value="Inactive" selected="@(Model.Status == "Inactive" ? "selected" : null)">Inactive Only</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <a asp-action="Tables" class="btn btn-secondary" style="height:38px; padding:0 18px;">Reset</a>
                    <button type="submit" class="btn btn-primary" style="height:38px; padding:0 22px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filter
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="dash-grid">
        <div class="card" style="padding:0; overflow:hidden;">
            <div class="data-table-container" style="border:none; border-radius:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Table</th>
                            <th>Capacity</th>
                            <th>Status</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Tables.Items.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                        <line x1="8" y1="21" x2="16" y2="21"></line>
                                        <line x1="12" y1="17" x2="12" y2="21"></line>
                                    </svg>
                                    <p class="empty-state-text">No tables match the query.</p>
                                    <a asp-action="Tables" class="btn btn-secondary btn-sm">Reset Filters</a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var table in Model.Tables.Items)
                        {
                            var qrUrl = Model.TableQrUrls.TryGetValue(table.TableID, out var url) ? url : "";
                            <tr class="@(table.IsActive ? "" : "is-dim")">
                                <td class="num" style="font-weight:700; font-size:14.5px;">Table @table.TableNumber</td>
                                <td class="num">@table.Capacity seats</td>
                                <td>
                                    <span class="badge @(table.IsActive ? "badge-ready" : "badge-neutral")">
                                        @(table.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <a href="@Url.Action("TableQr", new { tableId = table.TableID })" target="_blank" class="btn btn-outline btn-sm" style="padding:4px 8px; font-size:12px;">
                                        View QR
                                    </a>
                                    @if (!string.IsNullOrEmpty(qrUrl))
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" style="padding:4px 8px; font-size:12px;"
                                                onclick="copyQrLink('@qrUrl', this)">
                                            Copy Link
                                        </button>
                                    }
                                    <form asp-action="RegenerateQr" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tableId" value="@table.TableID" />
                                        <button type="submit" class="btn btn-outline btn-sm" style="padding:4px 8px; font-size:12px;" title="Regenerate QR token">
                                            Refresh
                                        </button>
                                    </form>
                                    <form asp-action="ToggleTableActive" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tableId" value="@table.TableID" />
                                        <button type="submit" class="btn btn-ghost btn-sm" style="padding:4px 8px;">
                                            @(table.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model.Tables" />
        </div>

        <div class="card">
            <h3 style="margin-bottom:16px;">Add New Table</h3>
            <form asp-action="CreateTable" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Table Number / Code</label>
                    <input type="text" name="tableNumber" placeholder="e.g. 10, T-04, Balcony-1" required />
                </div>
                <div class="form-group">
                    <label>Seating Capacity</label>
                    <input type="number" name="capacity" value="4" min="1" max="50" required />
                </div>
                <button type="submit" class="btn btn-primary btn-block" style="padding:12px; margin-top:8px;">
                    + Add Restaurant Table
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function copyQrLink(url, btn) {
        navigator.clipboard.writeText(url).then(() => {
            const originalText = btn.textContent;
            btn.textContent = "Copied!";
            btn.style.color = "var(--status-ready-text)";
            setTimeout(() => {
                btn.textContent = originalText;
                btn.style.color = "";
            }, 2000);
        }).catch(err => {
            prompt("Copy this customer QR link:", url);
        });
    }
</script>
