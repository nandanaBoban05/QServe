@model QServe.ViewModels.AdminOrderDetailsViewModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"Order #{order.OrderID:D5} Details";
    var latestPayment = order.Payment;
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <a asp-action="Orders" class="btn btn-ghost btn-sm" style="margin-bottom:8px; padding-left:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to Orders
            </a>
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                <h1 class="headline-lg" style="margin:0;">ORDER #@order.OrderID.ToString("D5")</h1>
                @{
                    string badgeClass = order.OrderStatus switch {
                        "Approved" => "badge-approved",
                        "Preparing" => "badge-preparing",
                        "Ready" => "badge-ready",
                        "Served" => "badge-served",
                        "Cancelled" => "badge-cancelled",
                        "PendingPayment" => "badge-pending",
                        "AwaitingVerification" => "badge-awaiting",
                        _ => "badge-neutral"
                    };
                }
                <span class="badge @badgeClass" style="font-size:13px; padding:5px 14px;">@order.OrderStatus</span>
                <span class="badge @(order.OrderType == "Quick" ? "tier-quick" : order.OrderType == "Heavy" ? "tier-heavy" : "tier-regular")" style="font-size:13px; padding:5px 14px;">
                    @order.OrderType Tier
                </span>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <span class="text-muted mono" style="font-size:13px;">Placed: @order.CreatedAt.ToIstString("MMM d, yyyy h:mm:ss tt")</span>
            @if (order.OrderStatus != "Cancelled")
            {
                <button type="button" class="btn btn-outline btn-sm" style="color:var(--error); border-color:var(--error); padding:4px 10px; font-size:12px;" onclick="openCancelOrderModal()">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    Cancel Order
                </button>
            }
        </div>
    </div>

    @if (TempData["OrderDetailsSuccess"] is string succMsg)
    {
        <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@succMsg</span>
        </div>
    }

    @if (TempData["OrderDetailsError"] is string errMsg)
    {
        <div class="card" style="background:var(--error-container); border-color:var(--error); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--on-error-container); font-weight:500;">@errMsg</span>
        </div>
    }

    @if (TempData["PaymentQueueMessage"] is string msg)
    {
        <div class="card" style="background:var(--status-ready-bg); border-color:var(--status-ready-border); padding:12px 16px; margin-bottom:16px;">
            <span style="font-size:13.5px; color:var(--status-ready-text); font-weight:500;">@msg</span>
        </div>
    }

    <!-- Quick Action Banner for Pending Offline Payment -->
    @if (latestPayment != null && latestPayment.PaymentStatus == "Pending" && (latestPayment.PaymentMode == "Cash" || latestPayment.PaymentMode == "Card"))
    {
        <div class="card mt-md" style="background:#fffbeb; border-color:#fde68a; padding:18px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
            <div>
                <div style="font-size:15px; font-weight:700; color:#92400e; display:flex; align-items:center; gap:8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Payment #@latestPayment.PaymentID Awaiting Verification (@latestPayment.PaymentMode &middot; ₹@latestPayment.Amount.ToString("0.00"))
                </div>
                <div style="font-size:13px; color:#b45309; margin-top:4px;">
                    Verify that the customer has settled ₹@latestPayment.Amount.ToString("0.00") via @latestPayment.PaymentMode before approving.
                </div>
            </div>
            <div style="display:flex; gap:8px;">
                <form asp-action="VerifyPayment" method="post" style="display:inline;" onsubmit="return handlePaymentAction(this);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@latestPayment.PaymentID" />
                    <input type="hidden" name="approve" value="true" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-primary" style="padding:8px 18px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Verify Payment
                    </button>
                </form>
                <button type="button" class="btn btn-outline" style="color:var(--error); border-color:var(--error);"
                        onclick="openRejectModal('@latestPayment.PaymentID', '@order.OrderID', '@latestPayment.Amount.ToString("0.00")', '@(order.Table?.TableNumber ?? "-")')">
                    Reject
                </button>
            </div>
        </div>
    }

    <!-- Order Overview Cards -->
    <div class="stat-grid mt-md">
        <div class="stat-card">
            <div>
                <div class="stat-label">Customer / Table Info</div>
                <div class="stat-value mt-sm" style="font-size:22px;">Table @(order.Table?.TableNumber ?? "-")</div>
            </div>
            <div class="text-muted" style="font-size:12px; margin-top:6px;">
                Dine-in Capacity: @(order.Table?.Capacity ?? 0) guests
            </div>
        </div>

        <div class="stat-card">
            <div>
                <div class="stat-label">Grand Total</div>
                <div class="stat-value mt-sm" style="font-size:24px; color:var(--primary);">₹@order.TotalAmount.ToString("0.00")</div>
            </div>
            <div class="text-muted" style="font-size:12px; margin-top:6px;">
                Total Items: @order.OrderItems.Sum(i => i.Quantity) items
            </div>
        </div>

        <div class="stat-card">
            <div>
                <div class="stat-label">Order Timing</div>
                <div class="stat-value mt-sm" style="font-size:20px;">@order.CreatedAt.ToIstTimeString("h:mm:ss tt")</div>
            </div>
            <div class="text-muted" style="font-size:12px; margin-top:6px;">
                Date: @order.CreatedAt.ToIst().ToString("MMM d, yyyy")
            </div>
        </div>

        <div class="stat-card">
            <div>
                <div class="stat-label">Active Payment Attempt</div>
                <div class="stat-value mt-sm" style="font-size:20px;">@(latestPayment?.PaymentMode ?? "None")</div>
            </div>
            <div style="font-size:12px; margin-top:6px;">
                @if (latestPayment != null)
                {
                    <span class="badge @(latestPayment.PaymentStatus == "Received" ? "badge-ready" : latestPayment.PaymentStatus == "Refunded" || latestPayment.PaymentStatus == "Failed" ? "badge-cancelled" : "badge-pending")" style="font-size:10.5px;">
                        @latestPayment.PaymentStatus
                    </span>
                }
                else
                {
                    <span class="text-muted">Unpaid / No Record</span>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(order.Notes))
    {
        <div class="card mt-md" style="background:#fffbeb; border-color:#fed7aa; padding:16px 20px;">
            <div style="display:flex; align-items:center; gap:8px; color:#9a3412;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <strong style="font-size:13px;">Customer &amp; Kitchen Notes</strong>
            </div>
            <p style="margin:6px 0 0; font-size:14px; color:var(--on-surface);">@order.Notes</p>
        </div>
    }

    <!-- Ordered Items Breakdown Chit -->
    <div class="card mt-lg">
        <h3 style="margin-bottom:16px;">ORDERED ITEMS BREAKDOWN</h3>
        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th style="text-align:right;">Unit Price</th>
                        <th style="text-align:center;">Qty</th>
                        <th style="text-align:right;">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in order.OrderItems)
                {
                    <tr>
                        <td>
                            <strong style="font-size:14.5px; color:var(--on-surface);">@(item.Item?.Name ?? "Item #" + item.ItemID)</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Customization))
                            {
                                <div style="font-size:12px; color:var(--error); margin-top:3px; font-style:italic;">
                                    Notes: @item.Customization
                                </div>
                            }
                        </td>
                        <td>@(item.Item?.Category?.Name ?? "-")</td>
                        <td>
                            <span class="badge badge-neutral">@(item.Item?.ItemType ?? "-")</span>
                        </td>
                        <td class="num" style="text-align:right;">₹@item.UnitPrice.ToString("0.00")</td>
                        <td class="num" style="text-align:center; font-weight:700; font-size:15px;">@item.Quantity</td>
                        <td class="num" style="text-align:right; font-weight:700; font-size:15px; color:var(--on-surface);">₹@item.LineTotal.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr style="border-top:2px solid var(--surface-container-high);">
                        <td colspan="4" style="font-weight:600; text-transform:uppercase; letter-spacing:0.04em; color:var(--on-surface-variant);">Subtotal</td>
                        <td class="num" style="text-align:center; font-weight:700;">@order.OrderItems.Sum(i => i.Quantity)</td>
                        <td class="num" style="text-align:right; font-weight:700;">₹@order.TotalAmount.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <td colspan="5" style="font-size:13px; color:var(--on-surface-muted); border-bottom:none;">Taxes, GST &amp; Service Charges</td>
                        <td class="num" style="text-align:right; font-size:13px; color:var(--on-surface-muted); border-bottom:none;">Included</td>
                    </tr>
                    <tr style="border-top:1px solid var(--outline-variant);">
                        <td colspan="5" style="font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--on-surface);">Final Amount</td>
                        <td class="num" style="text-align:right; font-size:20px; font-weight:800; color:var(--primary);">₹@order.TotalAmount.ToString("0.00")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Payment History & Order Lifecycle Timeline -->
    <div class="dash-grid mt-lg">
        <!-- Payment Attempts & History Section -->
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <h3 style="margin:0;">PAYMENT HISTORY &amp; ATTEMPTS</h3>
                <span class="mono text-muted" style="font-size:12px;">@Model.PaymentAttempts.Count attempt(s)</span>
            </div>

            @if (!Model.PaymentAttempts.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <p class="empty-state-text">No payment attempts recorded for this order.</p>
                </div>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:14px;">
                @for (int i = 0; i < Model.PaymentAttempts.Count; i++)
                {
                    var p = Model.PaymentAttempts[i];
                    var isLatest = i == 0;
                    <div style="border:1px solid @(isLatest ? "var(--outline)" : "var(--outline-variant)"); border-radius:var(--radius-lg); padding:14px 16px; background:@(isLatest ? "var(--surface)" : "var(--surface-container-low)");">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                            <div>
                                <span style="font-weight:700; font-size:14px; color:var(--on-surface);">
                                    Payment #@p.PaymentID
                                    @if (isLatest)
                                    {
                                        <span class="badge badge-neutral" style="font-size:10.5px; margin-left:6px;">Latest</span>
                                    }
                                </span>
                                <div style="font-size:12px; color:var(--on-surface-variant); margin-top:2px;">
                                    Mode: <strong>@p.PaymentMode</strong> &middot; @p.CreatedAt.ToIstString("MMM d, yyyy h:mm:ss tt")
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div class="num" style="font-weight:700; font-size:15px; color:var(--primary);">₹@p.Amount.ToString("0.00")</div>
                                <span class="badge @(p.PaymentStatus == "Received" ? "badge-ready" : p.PaymentStatus == "Refunded" || p.PaymentStatus == "Failed" ? "badge-cancelled" : "badge-pending")" style="font-size:11px; margin-top:3px;">
                                    @p.PaymentStatus
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(p.RejectionReason))
                        {
                            <div style="background:#fef2f2; border:1px solid #fee2e2; border-radius:var(--radius-sm); padding:6px 10px; margin-top:8px; font-size:12.5px; color:var(--error);">
                                <strong>Rejection Reason:</strong> @p.RejectionReason
                            </div>
                        }

                        @if (p.VerifiedByUser != null)
                        {
                            <div style="font-size:12px; color:var(--on-surface-variant); margin-top:6px;">
                                Verified by: <strong>@p.VerifiedByUser.FullName</strong> (@p.VerifiedByUser.Role) at @(p.VerificationTime.HasValue ? p.VerificationTime.Value.ToIstTimeString("h:mm:ss tt") : "-")
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(p.RazorpayPaymentID))
                        {
                            <div class="mono text-muted" style="font-size:11px; margin-top:4px;">
                                Razorpay ID: @p.RazorpayPaymentID
                            </div>
                        }
                    </div>
                }
                </div>
            }
        </div>

        <!-- Order Lifecycle Timeline -->
        <div class="card">
            <h3 style="margin-bottom:16px;">ORDER LIFECYCLE TIMELINE</h3>
            @if (!Model.Timeline.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <p class="empty-state-text">No audit timeline entries recorded for this order.</p>
                </div>
            }
            else
            {
                <ul class="activity-feed">
                @foreach (var log in Model.Timeline)
                {
                    <li>
                        <span class="activity-dot"></span>
                        <div style="flex:1;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <strong style="font-size:13.5px; color:var(--on-surface);">@log.Action.Replace("_", " ")</strong>
                                <span class="text-muted mono" style="font-size:11px;">@log.Timestamp.ToIstString("MMM d, h:mm:ss tt")</span>
                            </div>
                            <div style="font-size:12px; color:var(--on-surface-variant); margin-top:2px;">
                                By: <strong>@(log.PerformedByUser?.FullName ?? "System / Customer")</strong>
                                @if (log.PerformedByUser != null)
                                {
                                    <span class="badge badge-neutral" style="font-size:10px; margin-left:4px;">@log.PerformedByUser.Role</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(log.NewValue))
                            {
                                <div class="mono text-muted" style="font-size:11px; margin-top:4px; word-break:break-all; background:var(--surface-container-low); padding:6px 8px; border-radius:4px; border:1px solid var(--outline-subtle);">
                                    @log.NewValue
                                </div>
                            }
                        </div>
                    </li>
                }
                </ul>
            }
        </div>
    </div>
</div>

<!-- Modal for Payment Rejection Reason -->
<div id="rejectModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center; padding:16px;">
    <div class="card" style="max-width:480px; width:100%; box-shadow:var(--shadow-lg); border-radius:var(--radius-xl);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div style="display:flex; align-items:center; gap:8px; color:var(--error);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <h3 style="margin:0; font-size:18px;">REJECT PAYMENT</h3>
            </div>
            <button type="button" onclick="closeRejectModal()" class="btn btn-ghost btn-sm" style="padding:4px 8px; font-size:16px;">&times;</button>
        </div>

        <p style="font-size:14px; color:var(--on-surface-variant); margin-bottom:16px;">
            Reject payment for <strong id="modalOrderInfo" style="color:var(--on-surface);">Order #00000</strong> (<span id="modalTableInfo">Table T01</span>) of amount <strong id="modalAmountInfo" style="color:var(--primary);">₹0.00</strong>.
            The customer will be notified with the reason and offered the option to retry payment.
        </p>

        <form asp-action="VerifyPayment" method="post" id="rejectForm" onsubmit="return handlePaymentAction(this);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="paymentId" id="modalPaymentId" value="" />
            <input type="hidden" name="approve" value="false" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

            <div class="form-group">
                <label style="font-weight:600;">Rejection Reason</label>
                <select id="reasonPreset" onchange="applyReasonPreset(this)" style="margin-bottom:8px;">
                    <option value="">-- Choose Common Reason or Type Below --</option>
                    <option value="Cash amount not received at table">Cash amount not received at table</option>
                    <option value="Card transaction declined on POS terminal">Card transaction declined on POS terminal</option>
                    <option value="Incorrect currency or damaged notes">Incorrect currency or damaged notes</option>
                    <option value="Customer requested to change payment method">Customer requested to change payment method</option>
                    <option value="Customer cancelled payment attempt">Customer cancelled payment attempt</option>
                </select>
                <input type="text" name="rejectionReason" id="modalRejectionReason" placeholder="Enter reason (visible to customer)..." required maxlength="250" />
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                <button type="button" class="btn btn-secondary" onclick="closeRejectModal()">Cancel</button>
                <button type="submit" class="btn btn-danger">Confirm Rejection</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal for Order Cancellation -->
<div id="cancelOrderModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center; padding:16px;">
    <div class="card" style="max-width:480px; width:100%; box-shadow:var(--shadow-lg); border-radius:var(--radius-xl);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div style="display:flex; align-items:center; gap:8px; color:var(--error);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
                <h3 style="margin:0; font-size:18px;">CANCEL ORDER</h3>
            </div>
            <button type="button" onclick="closeCancelOrderModal()" class="btn btn-ghost btn-sm" style="padding:4px 8px; font-size:16px;">&times;</button>
        </div>

        <p style="font-size:14px; color:var(--on-surface-variant); margin-bottom:16px;">
            Are you sure you want to cancel <strong style="color:var(--on-surface);">Order #@order.OrderID.ToString("D5")</strong>?
            This will mark the order as Cancelled and remove it from the active kitchen workflow.
        </p>

        <form asp-action="CancelOrder" method="post" onsubmit="return handlePaymentAction(this);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@order.OrderID" />

            <div class="form-group">
                <label style="font-weight:600;">Cancellation Reason</label>
                <input type="text" name="reason" placeholder="e.g. Customer requested, kitchen out of ingredients..." required maxlength="250" />
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                <button type="button" class="btn btn-secondary" onclick="closeCancelOrderModal()">Keep Order</button>
                <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
            </div>
        </form>
    </div>
</div>

<script>
    function handlePaymentAction(form) {
        const btn = form.querySelector('button[type="submit"]');
        if (btn) {
            btn.disabled = true;
            btn.style.opacity = '0.6';
            btn.innerHTML = '<span style="display:inline-block; animation:spin 1s linear infinite;">↻</span> Processing...';
        }
        return true;
    }

    function openCancelOrderModal() {
        document.getElementById('cancelOrderModal').style.display = 'flex';
    }

    function closeCancelOrderModal() {
        document.getElementById('cancelOrderModal').style.display = 'none';
    }

    function openRejectModal(paymentId, orderId, amount, table) {
        document.getElementById('modalPaymentId').value = paymentId;
        document.getElementById('modalOrderInfo').textContent = 'Order #' + orderId.toString().padStart(5, '0');
        document.getElementById('modalTableInfo').textContent = 'Table ' + table;
        document.getElementById('modalAmountInfo').textContent = '₹' + amount;
        document.getElementById('modalRejectionReason').value = 'Cash amount not received at table';
        document.getElementById('reasonPreset').selectedIndex = 1;
        document.getElementById('rejectModal').style.display = 'flex';
    }

    function closeRejectModal() {
        document.getElementById('rejectModal').style.display = 'none';
    }

    function applyReasonPreset(select) {
        if (select.value) {
            document.getElementById('modalRejectionReason').value = select.value;
        }
    }
</script>
