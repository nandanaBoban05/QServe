@model QServe.ViewModels.AdminOrderFilterViewModel
@{
    ViewData["Title"] = "Order Management";
}

<partial name="_AdminNav" />

<div class="page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Operations</span>
            <h1>Order Management</h1>
        </div>
        <div class="mono text-muted" style="font-size:13px;">
            Total: <strong>@Model.Orders.TotalCount</strong> orders
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card" style="margin-bottom:20px; padding:18px 20px;">
        <form method="get" asp-action="Orders">
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap:12px; align-items:flex-end;">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Search</label>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Order #, Table..." />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Table</label>
                    <select name="TableId">
                        <option value="">All Tables</option>
                        @foreach (var table in Model.Tables)
                        {
                            <option value="@table.TableID" selected="@(Model.TableId == table.TableID ? "selected" : null)">
                                Table @table.TableNumber
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Order Status</label>
                    <select name="OrderStatus">
                        <option value="All" selected="@(Model.OrderStatus == "All" || string.IsNullOrEmpty(Model.OrderStatus) ? "selected" : null)">All Statuses</option>
                        <option value="Active" selected="@(Model.OrderStatus == "Active" ? "selected" : null)">⚡ Active Only</option>
                        <option value="PendingPayment" selected="@(Model.OrderStatus == "PendingPayment" ? "selected" : null)">Pending Payment</option>
                        <option value="AwaitingVerification" selected="@(Model.OrderStatus == "AwaitingVerification" ? "selected" : null)">Awaiting Verification</option>
                        <option value="Approved" selected="@(Model.OrderStatus == "Approved" ? "selected" : null)">Approved</option>
                        <option value="Preparing" selected="@(Model.OrderStatus == "Preparing" ? "selected" : null)">Preparing</option>
                        <option value="Ready" selected="@(Model.OrderStatus == "Ready" ? "selected" : null)">Ready</option>
                        <option value="Served" selected="@(Model.OrderStatus == "Served" ? "selected" : null)">Served</option>
                        <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled" ? "selected" : null)">Cancelled</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Payment Status</label>
                    <select name="PaymentStatus">
                        <option value="All" selected="@(Model.PaymentStatus == "All" || string.IsNullOrEmpty(Model.PaymentStatus) ? "selected" : null)">All</option>
                        <option value="Pending" selected="@(Model.PaymentStatus == "Pending" ? "selected" : null)">Pending</option>
                        <option value="Processing" selected="@(Model.PaymentStatus == "Processing" ? "selected" : null)">Processing</option>
                        <option value="Received" selected="@(Model.PaymentStatus == "Received" ? "selected" : null)">Received</option>
                        <option value="Failed" selected="@(Model.PaymentStatus == "Failed" ? "selected" : null)">Failed</option>
                        <option value="Refunded" selected="@(Model.PaymentStatus == "Refunded" ? "selected" : null)">Refunded</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Payment Mode</label>
                    <select name="PaymentMode">
                        <option value="All" selected="@(Model.PaymentMode == "All" || string.IsNullOrEmpty(Model.PaymentMode) ? "selected" : null)">All Modes</option>
                        <option value="Online" selected="@(Model.PaymentMode == "Online" ? "selected" : null)">Online (Razorpay)</option>
                        <option value="Cash" selected="@(Model.PaymentMode == "Cash" ? "selected" : null)">Cash</option>
                        <option value="Card" selected="@(Model.PaymentMode == "Card" ? "selected" : null)">Card (POS)</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Tier</label>
                    <select name="OrderType">
                        <option value="All" selected="@(Model.OrderType == "All" || string.IsNullOrEmpty(Model.OrderType) ? "selected" : null)">All Tiers</option>
                        <option value="Quick" selected="@(Model.OrderType == "Quick" ? "selected" : null)">Quick</option>
                        <option value="Regular" selected="@(Model.OrderType == "Regular" ? "selected" : null)">Regular</option>
                        <option value="Heavy" selected="@(Model.OrderType == "Heavy" ? "selected" : null)">Heavy</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Date From</label>
                    <input type="date" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label>Date To</label>
                    <input type="date" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div style="display:flex; gap:6px;">
                    <button type="submit" class="btn btn-primary btn-sm" style="height:40px; flex:1;">Filter</button>
                    <a asp-action="Orders" class="btn btn-outline btn-sm" style="height:40px; padding:0 12px; display:inline-flex; align-items:center;">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Orders Table -->
    <div class="card">
    @if (!Model.Orders.Items.Any())
    {
        <p class="kds-empty">No orders matching the selected filters.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Table</th>
                        <th>Status</th>
                        <th>Tier</th>
                        <th>Payment</th>
                        <th>Total</th>
                        <th>Placed</th>
                        <th style="text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model.Orders.Items)
                {
                    <tr>
                        <td class="num">
                            <a asp-action="OrderDetails" asp-route-id="@order.OrderID" style="font-weight:700; text-decoration:underline;">
                                #@order.OrderID.ToString("D5")
                            </a>
                        </td>
                        <td>Table @(order.Table?.TableNumber ?? "-")</td>
                        <td>
                            @{
                                string badgeClass = order.OrderStatus switch {
                                    "Approved" => "badge-curry",
                                    "Preparing" => "badge-turmeric",
                                    "Ready" => "badge-curry",
                                    "Served" => "badge-steel",
                                    "Cancelled" => "badge-tamarind",
                                    _ => "badge-steel"
                                };
                            }
                            <span class="badge @badgeClass">@order.OrderStatus</span>
                        </td>
                        <td>
                            <span class="badge @(order.OrderType == "Quick" ? "badge-curry" : order.OrderType == "Heavy" ? "badge-tamarind" : "badge-turmeric")">
                                @order.OrderType
                            </span>
                        </td>
                        <td>
                            @if (order.Payment != null)
                            {
                                <span style="font-size:12px;">@order.Payment.PaymentMode</span>
                                <span class="badge @(order.Payment.PaymentStatus == "Received" ? "badge-curry" : order.Payment.PaymentStatus == "Refunded" || order.Payment.PaymentStatus == "Failed" ? "badge-tamarind" : "badge-turmeric")" style="font-size:9px; margin-left:2px;">
                                    @order.Payment.PaymentStatus
                                </span>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:12px;">None</span>
                            }
                        </td>
                        <td class="num" style="font-weight:600;">₹@order.TotalAmount.ToString("0.00")</td>
                        <td class="num" style="font-size:12.5px;">@order.CreatedAt.ToString("MMM d, HH:mm")</td>
                        <td style="text-align:right;">
                            <a asp-action="OrderDetails" asp-route-id="@order.OrderID" class="btn btn-outline btn-sm">Details →</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model.Orders" />
    }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/kitchen")
        .withAutomaticReconnect()
        .build();

    connection.on("OrderStatusUpdate", () => window.location.reload());
    connection.on("PaymentPendingVerification", () => window.location.reload());
    connection.start().catch(err => console.error("SignalR connection failed:", err));
</script>
